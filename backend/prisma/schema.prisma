generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FOUNDER
  ADMIN
  EMPLOYEE
}

enum Direction {
  BACHELOR
  MASTER
  LANGUAGE
  LANGUAGE_COLLEGE
  LANGUAGE_BACHELOR
  COLLEGE
}

enum ApplicationStatus {
  NEW
  IN_PROGRESS // legacy → DOCS_REVIEW
  COMPLETED // legacy → ENROLLED
  DOCS_REVIEW
  DOCS_SUBMITTED
  PRE_ADMISSION
  AWAITING_PAYMENT
  ENROLLED
}

enum StudentStatus {
  ACTIVE
  PAUSED
  GRADUATED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// Soft delete: вместо физического удаления через `prisma.X.delete()`
// сервисы выставляют `deletedAt = now()`. Все списки/findUnique фильтруют
// `where: { deletedAt: null }`. Даже если атакующий вызовет DELETE-эндпоинт
// или прямой SQL, данные останутся в БД и могут быть восстановлены FOUNDER'ом
// через установку deletedAt обратно в null. Бэкапы (Daily/Weekly/Monthly на
// Railway) — вторая линия обороны.
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  fullName  String
  role      Role      @default(EMPLOYEE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  notifications            Notification[]
  managedApplications      Application[]  @relation("ApplicationManager")
  managedChinaApplications Application[]  @relation("ApplicationChinaManager")
  managedStudents          Student[]      @relation("StudentManager")
  managedChinaStudents     Student[]      @relation("StudentChinaManager")
  assignedTasks            Task[]         @relation("TaskAssignee")
  createdTasks             Task[]         @relation("TaskCreator")

  createdPayments         Payment[]         @relation("PaymentCreatedBy")
  submittedPayments       Payment[]         @relation("PaymentSubmittedBy")
  approvedPayments        Payment[]         @relation("PaymentApprovedBy")
  rejectedPayments        Payment[]         @relation("PaymentRejectedBy")
  voidedPayments          Payment[]         @relation("PaymentVoidedBy")
  updatedPaymentSchedules PaymentSchedule[] @relation("PaymentScheduleUpdatedBy")

  // Раздел 3 ТЗ (заявки/консультации, волна 3).
  archivedApplications Application[]  @relation("ApplicationArchivedBy")
  heldConsultations    Consultation[] @relation("ConsultationManager")
  createdConsultations Consultation[] @relation("ConsultationCreatedBy")

  // Волна 4: реестр грантов, комментарии, звонки.
  createdGrants StudentGrant[] @relation("StudentGrantCreatedBy")
  comments      Comment[]      @relation("CommentAuthor")
  calls         Call[]         @relation("CallUser")

  // Раздел 5 ТЗ (волна 6) — договоры, KPI, зарплата. Скалярных полей у User
  // НЕ появляется намеренно: в проекте есть prisma.user.findFirst({ where })
  // без select — любой новый скаляр User разъехался бы по коду сам собой.
  contracts            Contract[]             @relation("ContractManager")
  signedContracts      Contract[]             @relation("ContractSignedBy")
  terminatedContracts  Contract[]             @relation("ContractTerminatedBy")
  createdContracts     Contract[]             @relation("ContractCreatedBy")
  touchedApplications  Application[]          @relation("ApplicationFirstTouchBy")
  enrolledApplications Application[]          @relation("ApplicationEnrolledBy")
  compensations        EmployeeCompensation[] @relation("CompensationEmployee")
  setCompensations     EmployeeCompensation[] @relation("CompensationCreatedBy")
  createdRuleSets      BonusRuleSet[]         @relation("BonusRuleSetCreatedBy")
  activatedRuleSets    BonusRuleSet[]         @relation("BonusRuleSetActivatedBy")
  personalBonusRules   BonusRule[]            @relation("BonusRuleUser")
  payslips             Payslip[]              @relation("PayslipUser")
  calculatedPayslips   Payslip[]              @relation("PayslipCalculatedBy")
  approvedPayslips     Payslip[]              @relation("PayslipApprovedBy")
  paidPayslips         Payslip[]              @relation("PayslipPaidBy")
  voidedPayslips       Payslip[]              @relation("PayslipVoidedBy")

  // ── Волна 8: билеты, база знаний, AI-помощник, диалоги мессенджеров. ──
  // По-прежнему НИ ОДНОГО нового СКАЛЯРНОГО поля у User (см. комментарий к
  // разделу 5 выше): в проекте есть prisma.user.findFirst({ where }) без
  // select, и любой новый скаляр разъехался бы по коду сам собой.
  createdTickets        Ticket[]             @relation("TicketCreatedBy")
  createdArticles       KnowledgeArticle[]   @relation("KnowledgeArticleCreatedBy")
  updatedArticles       KnowledgeArticle[]   @relation("KnowledgeArticleUpdatedBy")
  aiMessages            AiChatMessage[]      @relation("AiChatMessageUser")
  assignedConversations Conversation[]       @relation("ConversationAssignee")
  sentMessages          ChannelMessage[]     @relation("ChannelMessageAuthor")

  @@index([deletedAt])
}

// Заявка на обучение: создаётся через лендинг (POST /applications/public),
// либо автоматически вместе со студентом из CRM ("+ Студент").
// При удалении любого из связанных объектов (User-менеджер, Program) заявка
// остаётся в БД с обнулённой ссылкой (SetNull) — историю не теряем.
// При удалении Student — Application НЕ удаляется автоматически
// (нет onDelete: Cascade на student-связи), поэтому в applications.service.remove()
// студент явно удаляется отдельно.
model Application {
  id             String            @id @default(uuid())
  fullName       String
  phone          String
  email          String?
  direction      Direction
  comment        String?
  status         ApplicationStatus @default(NEW)
  studentId      String?
  // student → SetNull-семантика по сути не задана, потому что removed применяется в коде вручную.
  student        Student?          @relation(fields: [studentId], references: [id])
  managerId      String?
  // Удалили сотрудника-менеджера TJ → менеджер у заявки обнуляется, заявка остаётся.
  manager        User?             @relation("ApplicationManager", fields: [managerId], references: [id], onDelete: SetNull)
  chinaManagerId String?
  // Аналогично для китайского менеджера.
  chinaManager   User?             @relation("ApplicationChinaManager", fields: [chinaManagerId], references: [id], onDelete: SetNull)
  programId      String?
  // Удалили программу → у заявки programId становится null.
  program        Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)

  // ── ТЗ 3.1: источник привлечения ───────────────────────────────────
  // String, а НЕ enum. Причина: деплой гоняет `prisma db push --accept-data-loss`.
  // Добавить значение в pg-enum он умеет, но удалить/переименовать/переставить —
  // это DROP TYPE + CREATE TYPE, то есть потеря колонки на живых данных.
  // Волна 7 (Chat Place) принесёт реальные названия каналов из вебхуков, и
  // список ТОЧНО будет меняться. Тот же приём уже применён в проекте к
  // ActivityLog.action и Document.type — новые значения без миграции.
  // Единственный источник истины по значениям — backend/src/common/lead-source.ts,
  // валидация @IsIn(LEAD_SOURCE_VALUES) в DTO на ОБОИХ путях записи.
  // null у 229 исторических заявок = «источник не указан». Бэкфилла НЕТ
  // намеренно: проставить всем WEBSITE — значит выдумать факт и испортить
  // ровно тот отчёт по каналам, ради которого поле и заводится.
  source       String?
  // Уточнение свободным текстом: @ник аккаунта, id рекламной кампании,
  // имя рекомендателя, utm_source «как пришёл». Отдельно от source, чтобы
  // source оставался счётным для GROUP BY. Длина режется в DTO (@MaxLength(200)).
  sourceDetail String?

  // ── ТЗ 3.1: архив ──────────────────────────────────────────────────
  // Признак архивности — nullable timestamp, а не Boolean: тот же приём,
  // что у deletedAt (бесплатно получаем «когда»), плюс на живой таблице это
  // ADD COLUMN NULL без переписывания 229 строк. Архив ПОЛНОСТЬЮ обратим:
  // «Вернуть из архива» ставит archivedAt = null, данные не трогаются.
  archivedAt    DateTime?
  archivedById  String?
  // Уволенного сотрудника soft-удаляют → ссылка обнуляется, факт архивации
  // остаётся (та же семантика, что у manager/chinaManager выше).
  archivedBy    User?     @relation("ApplicationArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  // 'MANUAL: <текст менеджера>' либо 'AUTO: зачислен, 30 дней без изменений'.
  // Свободная строка, а не enum: причин будет больше, чем мы сейчас знаем.
  archiveReason String?

  // ── ТЗ 3.1: «повторное обращение» ──────────────────────────────────
  // Ключ склейки — НОРМАЛИЗОВАННЫЙ телефон. phone хранится так, как ввёл
  // клиент («+992 90 123-45-67», «901234567»), сравнивать сырые строки
  // бесполезно. Денормализованная колонка, а не вычисление на лету: по ней
  // идёт индексный поиск на КАЖДОЕ создание заявки.
  // Заполняется normalizePhone() из common/phone.ts при создании + разовым
  // идемпотентным бэкфиллом на старте (условие `phoneNormalized: null`).
  // ВАЖНО для кода: у заявки, созданной из students.service (phones[0] || ''),
  // телефона может не быть вовсе → здесь остаётся null, и поиск «повторных»
  // обязан ВЫХОДИТЬ РАНЬШЕ, а не искать `phoneNormalized: null` (Prisma
  // превратит это в IS NULL и склеит все безтелефонные заявки в одну кучу).
  phoneNormalized String?
  // Ссылка на ПЕРВУЮ (корневую) заявку с тем же phoneNormalized — не на
  // предыдущую. Тогда все обращения одного человека имеют ОДИН repeatOfId и
  // группируются одним индексным запросом, без рекурсии по цепочке.
  // Это ПОДСКАЗКА, а не склейка личностей: ничего не копируется, студент не
  // привязывается, менеджер сбрасывает флаг в null одной кнопкой.
  repeatOfId      String?
  repeatOf        Application?  @relation("ApplicationRepeat", fields: [repeatOfId], references: [id], onDelete: SetNull)
  repeats         Application[] @relation("ApplicationRepeat")

  // ТЗ 3.2 — таймлайн консультаций в карточке заявки.
  consultations Consultation[]

  // ТЗ 6.3 (волна 4) — лента комментариев и звонков в карточке заявки.
  comments Comment[]
  calls    Call[]

  // Раздел 5 ТЗ (волна 6) — договоры, заключённые по этой заявке.
  contracts Contract[]

  // ТЗ 6.4 (волна 8) — диалоги мессенджеров, привязанные к этой заявке.
  conversations Conversation[]

  // ВЕХА «ЛИД ОБРАБОТАН» (метрика ТЗ 5.1). Денормализованные поля, а не
  // вычисление из ActivityLog: журнал НЕ содержит applicationId (STATUS_CHANGE
  // пишет только studentId, а у заявки без студента он null), парсинг
  // details-строки хрупок, а индекса под такой запрос там нет вовсе.
  // Тот же приём, что Payment.stageOrder и StudentGrant.nextYearStartsAt.
  // Ставятся РОВНО ОДИН РАЗ claim-апдейтом (паттерн B из job.contract.ts):
  //   updateMany({ where: { id, firstTouchAt: null }, data: { ... } })
  // Триггеры: первый уход статуса из NEW, архивация с причиной, привязка
  // первой консультации. АТРИБУЦИЯ: managerId заявки ?? id действующего
  // пользователя — заслуга у закреплённого менеджера, а не у администратора,
  // который нажал кнопку за него. Снимок, а не чтение managerId на лету:
  // переназначение в октябре не имеет права переписать сентябрьский KPI.
  // 229 исторических заявок остаются с null — бэкфилла НЕТ намеренно
  // (тот же довод, что у Application.source: выдуманный факт испортит ровно
  // ту метрику, ради которой поле заводится). Метрика ведётся с даты выката.
  firstTouchAt   DateTime?
  firstTouchById String?
  firstTouchBy   User?     @relation("ApplicationFirstTouchBy", fields: [firstTouchById], references: [id], onDelete: SetNull)

  // ВЕХА «ЗАЧИСЛЕН» (метрика ТЗ 5.1 «доведение до зачисления»). Тот же
  // claim-апдейт. НЕОБРАТИМА: откат статуса назад её не обнуляет — иначе
  // мартовский KPI переписался бы задним числом апрельским откатом.
  // Повторное зачисление после отката второго факта не создаёт (поле занято).
  enrolledAt   DateTime?
  enrolledById String?
  enrolledBy   User?     @relation("ApplicationEnrolledBy", fields: [enrolledById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([direction])
  @@index([managerId])
  @@index([chinaManagerId])
  @@index([programId])
  @@index([deletedAt])
  // Старый индекс НЕ удаляем: db push сделает реальный DROP INDEX, а он всё
  // ещё обслуживает stats() и любые запросы, которые про архив не знают.
  @@index([deletedAt, createdAt(sort: Desc)])
  // ГЛАВНЫЙ индекс вкладок «Все» / «Новые» / «В работе»:
  // deletedAt IS NULL AND archivedAt IS NULL [AND status=?] ORDER BY createdAt DESC.
  // Обе ведущие колонки зафиксированы условием IS NULL, поэтому порядок по
  // createdAt DESC берётся прямо из индекса — сортировки не будет. Он же
  // обслуживает фильтр по датам (createdAt BETWEEN — range по последней колонке).
  @@index([deletedAt, archivedAt, createdAt(sort: Desc)])
  // Вкладка + фильтр по источнику: «сколько лидов дал Instagram за март».
  // Отдельный индекс, потому что source встаёт МЕЖДУ archivedAt и createdAt,
  // а значит из индекса выше сортировка бы не вышла.
  @@index([deletedAt, archivedAt, source, createdAt(sort: Desc)])
  // «Этот человек уже обращался?» — на каждое создание заявки.
  @@index([phoneNormalized])
  // Цепочка обращений одного человека + вкладка «Ранее зарегистрированные».
  @@index([repeatOfId])
  // Раздел 5 ТЗ (волна 6): «обработанные лиды менеджера за период» —
  // count целиком из индекса.
  @@index([deletedAt, firstTouchById, firstTouchAt])
  // «Доведено до зачисления за период».
  @@index([deletedAt, enrolledById, enrolledAt])
  // «Потеряно за период» (архив без зачисления) — знаменатель deliveryRate.
  @@index([deletedAt, managerId, archivedAt])
}

model Student {
  id              String        @id @default(uuid())
  fullName        String
  phones          String[]      @default([])
  email           String?
  password        String?
  applicationForm Json?
  photoUrl        String?
  direction       Direction
  cabinet         Int
  status          StudentStatus @default(ACTIVE)
  comment         String?
  managerId       String?
  manager         User?         @relation("StudentManager", fields: [managerId], references: [id], onDelete: SetNull)
  chinaManagerId  String?
  chinaManager    User?         @relation("StudentChinaManager", fields: [chinaManagerId], references: [id], onDelete: SetNull)
  programId       String?
  program         Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  documents       Document[]
  applications    Application[]
  payments        Payment[]
  paymentSchedule PaymentSchedule[]
  // Раздел 3.2 ТЗ — таймлайн консультаций/собеседований в карточке студента.
  consultations   Consultation[]

  // Раздел «Билеты» (волна 8) — перелёты студента. Связь, а не скаляр: в
  // /student-auth/me не утечёт (там include с явным перечислением полей).
  tickets Ticket[]

  // ТЗ 6.4 (волна 8) — диалоги мессенджеров, привязанные к этому студенту.
  conversations Conversation[]

  // ТЗ 4 (волна 4) — реестр «двойных грантов». Скалярных полей у Student НЕ
  // появляется намеренно: они автоматически уехали бы студенту в
  // /student-auth/me (student-auth.service.ts:129 читает через include).
  grants   StudentGrant[]
  // ТЗ 6.3 (волна 4) — лента комментариев и звонков в карточке студента.
  comments Comment[]
  calls    Call[]

  // Раздел 5 ТЗ (волна 6) — договоры студента. Связь, а не скаляр — в
  // /student-auth/me не утечёт (там include с явным перечислением).
  contracts Contract[]

  @@index([direction])
  @@index([cabinet])
  @@index([status])
  @@index([managerId])
  @@index([chinaManagerId])
  @@index([programId])
  @@index([deletedAt])
  // Composite — для главного списка студентов:
  // WHERE deletedAt IS NULL ORDER BY createdAt DESC. Без этого
  // Postgres делает seq scan + sort даже на нашей таблице.
  @@index([deletedAt, createdAt(sort: Desc)])
}

// Документ студента (10 типов + OTHER, + RECEIPT для чеков платежей — см. Payment).
// onDelete: Restrict (Проблема 7 аудита волны 1, п.11 — раньше был Cascade,
// единственная Cascade-связь в схеме). В коде НЕТ ни одного физического
// prisma.student.delete() (только soft-delete через deletedAt, см. правило
// проекта №1), поэтому Cascade здесь никогда не срабатывал на практике —
// но именно поэтому и опасен: любое будущее физическое удаление студента
// (скрипт миграции, консоль Railway, ошибка) беззвучно снесло бы документы,
// включая чеки (Document.paymentId) — часть финансового аудит-следа.
// Restrict превращает такое удаление в ошибку БД вместо тихой потери данных.
model Document {
  id           String    @id @default(uuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  type         String    @default("OTHER")
  // Чек привязан и к студенту (studentId, как все документы — отсюда бесплатная
  // защита /uploads), и к платежу. SetNull, а не Cascade: платёж физически
  // никогда не удаляется, но если это когда-нибудь произойдёт, файл обязан
  // остаться под правами студента, а не исчезнуть.
  paymentId    String?
  payment      Payment?  @relation("PaymentReceipts", fields: [paymentId], references: [id], onDelete: SetNull)
  // Скан подписанного договора (волна 6). Тот же приём, что paymentId: документ
  // привязан и к студенту (studentId — отсюда бесплатная защита /uploads
  // через files/file-resolver.service.ts), и к договору. SetNull — файл
  // обязан пережить любые операции над договором.
  contractId   String?
  contract     Contract? @relation("ContractDocuments", fields: [contractId], references: [id], onDelete: SetNull)
  // Маршрутная квитанция / скан билета (раздел «Билеты», волна 8). Тот же
  // приём, что paymentId и contractId: документ привязан и к студенту
  // (studentId — отсюда бесплатная защита /uploads через
  // files/file-resolver.service.ts), и к билету. SetNull — файл обязан
  // пережить любые операции над записью билета.
  ticketId     String?
  ticket       Ticket?   @relation("TicketDocuments", fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([studentId, type])
  @@index([deletedAt])
  @@index([paymentId])
  @@index([contractId])
  @@index([ticketId])
}

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String
  status       TaskStatus @default(TODO)
  assignedToId String
  assignedTo   User       @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // ТЗ 3.2 — дата И ВРЕМЯ повторного звонка. Опционально: у существующих
  // и у всех ручных задач срока нет. Хранится в UTC, как все DateTime схемы.
  // Фронт вводит через <input type="datetime-local"> и шлёт new Date(v).toISOString():
  // JS трактует datetime-local как ЛОКАЛЬНОЕ время браузера, а браузер менеджера
  // стоит по Душанбе — «10:00» само превращается в 05:00Z, TZ-математики на
  // сервере для этого пути не нужно вообще.
  dueDate DateTime?

  // КЛЮЧ ИДЕМПОТЕНТНОСТИ автосозданных задач. Формат '<тип>:<id источника>':
  //   'consultation-followup:<consultationId>'  — волна 3
  //   'academic-year:<studentId>:<год>'         — волна 4 (Multi-Grant)
  // @unique — защита живёт в БД, а не в коде: два инстанса Railway, повторный
  // прогон крона и рестарт контейнера ФИЗИЧЕСКИ не могут создать дубль,
  // второй INSERT падает с P2002, сервис его молча глотает.
  // Nullable: у ручных задач ключа нет, а в Postgres NULL'ы в unique-индексе
  // между собой не конфликтуют — существующие строки проходят как есть.
  // Следствие, которое надо знать: если менеджер soft-delete'нул автозадачу,
  // планировщик её НЕ воскресит (ключ занят) — это правильное поведение.
  // Поэтому пересинхронизация (перенос даты звонка) обязана искать задачу по
  // originKey ВКЛЮЧАЯ deletedAt != null и явно решать, воскрешать или нет.
  originKey String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Проблема 11 аудита волны 1: раньше tasks.service.remove() делал
  // prisma.task.delete() — единственное физическое удаление в проекте,
  // прямое нарушение правила №1. Поле опциональное — безопасно для
  // `prisma db push --accept-data-loss` на боевой БД с существующими задачами.
  deletedAt DateTime?

  // Обратная сторона 1:1 связи с консультацией (FK живёт на Consultation).
  consultation Consultation? @relation("ConsultationFollowUpTask")

  @@index([assignedToId])
  @@index([status])
  @@index([deletedAt])
  // «Мои задачи по срокам» + красный бейдж «просрочено» на странице Задачи.
  @@index([assignedToId, status, dueDate])
  // Планировщик и общий список «ближайшие сроки»:
  // WHERE deletedAt IS NULL AND dueDate <= ? ORDER BY dueDate.
  @@index([deletedAt, dueDate])
}

model Program {
  id                String    @id @default(uuid())
  name              String
  university        String
  city              String
  major             String
  direction         Direction
  cost              Float
  currency          String    @default("CNY")
  duration          String?
  language          String?
  description       String?
  imageUrl          String?
  published         Boolean   @default(true)
  telegramMessageId Int?
  telegramHasPhoto  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  applications Application[]
  students     Student[]

  @@index([city])
  @@index([major])
  @@index([direction])
  @@index([published])
  @@index([deletedAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "APPLICATION_NEW", "APPLICATION_DELAY", etc.
  title     String
  message   String
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorName   String
  actorRole   String // ADMIN | EMPLOYEE
  action      String // "STATUS_CHANGE" | "STUDENT_UPDATE" | "MANAGER_CHANGE" | "STUDENT_CREATE" | "STUDENT_DELETE"
  studentId   String?
  studentName String?
  details     String // human-readable: "Статус: NEW → DOCS_REVIEW", "Менеджер TJ: A → B"
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([studentId])
  @@index([actorId])
}

// Сквозная финансовая шкала из ТЗ 1.2. Иерархии «1 / 1.1 / 2 / 2.1» в БД НЕТ:
// по смыслу это 6 самостоятельных платежей в разное время, а не дерево.
// Порядок объявления = порядок в UI, но сортируем по Payment.stageOrder,
// а не по порядку значений enum (переставить значения enum потом = DROP TYPE).
// Подписи для UI (не в БД): INITIAL — «Этап 1. Первичная оплата»,
// REGISTRATION — «Этап 1.1. Регистрация студента», DOCUMENTATION — «Этап 2.
// Документация (виза, приглашение)», ENROLLMENT — «Этап 2.1. После зачисления»,
// RELOCATION — «Этап 3. После переезда в Китай»,
// LIVING_EXPENSES — «Этап 4. Расходы на месте».
enum PaymentStage {
  INITIAL
  REGISTRATION
  DOCUMENTATION
  ENROLLMENT
  RELOCATION
  LIVING_EXPENSES
}

// Этапы 1–3 (SCHEDULE) — разовые платежи агентству по договору: есть плановая
// сумма и срок, попадают в блок «График платежей».
// Этап 4 (ON_SITE) — регулярные расходы студента уже в Китае: плана нет, есть
// только факт, отдельный блок «Расходы на месте».
// Поле денормализовано (выводится из stage), потому что по нему UI и отчёты
// делят выборку, и без него каждый запрос тащил бы NOT IN (...) по stage.
enum PaymentKind {
  SCHEDULE
  ON_SITE
}

// payment_purpose из ТЗ 1.3, ровно 8 значений:
// Регистрация студента / Документация / Зачисление в университет /
// После переезда / Проживание / Питание / Консультация / Другое.
enum PaymentPurpose {
  REGISTRATION
  DOCUMENTATION
  ENROLLMENT
  RELOCATION
  ACCOMMODATION
  FOOD
  CONSULTATION
  OTHER
}

// payment_method из ТЗ 1.3: Наличные / Безналичный расчёт.
// Имя CASHLESS (а не BANK) намеренно — 'BANK' уже занят как Document.type
// (справка из банка), одинаковые строки в разных справочниках путают.
enum PaymentMethod {
  CASH
  CASHLESS
}

// Double Check (ТЗ 1.1): деньги считаются полученными ТОЛЬКО в APPROVED.
// DRAFT — черновик, PENDING_APPROVAL — «Ожидает одобрения Основателем»,
// REJECTED — отклонён (правится и подаётся заново той же записью),
// VOID — аннулирован после одобрения (правило проекта: не удаляем, а сторнируем).
enum PaymentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  VOID
}

// ФАКТ оплаты. Одна строка = одно фактическое поступление денег.
// Частичные оплаты одного этапа — это несколько строк с одним stage, поэтому
// плановая сумма живёт НЕ здесь, а в PaymentSchedule (иначе план дублировался
// бы в каждой частичной оплате и разъезжался).
model Payment {
  id String @id @default(uuid())

  studentId String
  // onDelete: Restrict, а не Cascade (Проблема 7 аудита волны 1): studentId
  // обязателен (не nullable), поэтому SetNull невозможен. Финансовая история
  // (факты оплат, чеки через Document.paymentId) не должна беззвучно
  // исчезать, если студент когда-нибудь будет физически удалён — Restrict
  // заставит такую операцию упасть с ошибкой БД, а не молча снести бухгалтерию.
  // Сейчас студент удаляется только soft (deletedAt), поэтому ограничение
  // ничего не ломает при обычной работе.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Волна 6 (Contract) добавит сюда relation. Сейчас — «голый» nullable-скаляр:
  // так волна 6 навесит связь одним ALTER TABLE ADD CONSTRAINT, без миграции данных.
  contractId String?
  // Волна 6 навешивает связь на уже существующий «голый» скаляр: db push
  // делает один ALTER TABLE ADD CONSTRAINT, миграции данных нет — во всех
  // строках contractId сейчас NULL (в коде нет ни одной записи этого поля),
  // поэтому FK валидируется мгновенно и ни одна строка его не нарушает.
  // Restrict (не SetNull): платёж, потерявший договор, молча выпадает из
  // зарплатной атрибуции — это тихая порча денежного отчёта.
  contract   Contract? @relation("ContractPayments", fields: [contractId], references: [id], onDelete: Restrict)

  stage      PaymentStage
  // Денормализация ради сортировки/группировки в отчётах: ORDER BY stageOrder
  // не зависит от порядка объявления значений enum в Postgres (менять его
  // потом = пересоздание типа). Заполняется сервисом из константы STAGE_ORDER.
  stageOrder Int            @default(0)
  kind       PaymentKind    @default(SCHEDULE)
  purpose    PaymentPurpose
  method     PaymentMethod

  // Деньги — только Decimal. Float даёт 0.1+0.2=0.30000000000000004 и
  // расхождение в сводке «оплачено/осталось». 12,2 = до 9 999 999 999.99 TJS.
  amount   Decimal @db.Decimal(12, 2)
  // Валюта проекта одна (сомони). Поле оставлено, чтобы не переделывать схему,
  // если когда-нибудь появится вторая; UI селектор валюты НЕ показывает.
  currency String  @default("TJS")

  // Фактическая дата поступления денег (её вводит менеджер, может отличаться
  // от createdAt). Все отчёты «за период» строятся по paidAt, а не по createdAt.
  paidAt  DateTime  @default(now())
  // Снимок планового срока этапа на момент внесения платежа (копируется из
  // PaymentSchedule.dueDate). Нужен для KPI «своевременность сбора оплат» из раздела 5:
  // если потом отредактировать план, историческая метрика не должна «переехать».
  dueDate DateTime?

  // Номер квитанции/банковской транзакции — Основателю нужно чем-то сверять
  // безнал с выпиской, глазами по фото чека это не делается.
  reference String?
  comment   String?

  status PaymentStatus @default(DRAFT)

  // Кто внёс данные. SetNull — уволенного сотрудника soft-удаляют, платёж
  // должен остаться (та же семантика, что у Application.manager).
  createdById String?
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Кто нажал «Подтвердить». Ключевое поле Double Check: одобрить платёж
  // может только пользователь, чей id НЕ равен submittedById.
  submittedById String?
  submittedBy   User?     @relation("PaymentSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?

  // Финальное акцептование Основателя. approvedAt НИКОГДА не обнуляется,
  // даже при последующем VOID — иначе теряется дата проведения для аудита.
  approvedById String?
  approvedBy   User?     @relation("PaymentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  // Последнее отклонение. Полная история отклонений — в ActivityLog
  // (action = 'PAYMENT_REJECT'), здесь только «что показать менеджеру сейчас».
  rejectedById    String?
  rejectedBy      User?     @relation("PaymentRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?
  rejectionReason String?

  // Аннулирование уже проведённого платежа (ошибка ввода). Правило проекта —
  // никогда не удалять: APPROVED нельзя ни удалить, ни отредактировать, только
  // перевести в VOID с причиной, и он перестаёт учитываться в суммах.
  voidedById String?
  voidedBy   User?     @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidedAt   DateTime?
  voidReason String?

  // Чеки — обычные Document (type='RECEIPT'), поэтому автоматически получают
  // защиту /uploads через files/file-resolver.service.ts (ветка DOCUMENT).
  receipts Document[] @relation("PaymentReceipts")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  // Отдельный @@index([deletedAt]) не нужен: он префикс двух composite-индексов
  // выше, Postgres использует их — лишний индекс только замедлял бы запись.

  // Карточка студента: WHERE studentId=? AND deletedAt IS NULL ORDER BY stageOrder.
  @@index([studentId, deletedAt, stageOrder])
  // Очередь Основателя: WHERE status='PENDING_APPROVAL' AND deletedAt IS NULL
  // ORDER BY submittedAt (сначала те, кто ждёт дольше всех).
  @@index([status, deletedAt, submittedAt])
  // Отчёт «проведено за период»: status='APPROVED' + paidAt BETWEEN, сортировка по дате.
  @@index([status, deletedAt, paidAt(sort: Desc)])
  // Общий список страницы «Финансы» без фильтра по статусу.
  @@index([deletedAt, paidAt(sort: Desc)])
  // Просрочки/ближайшие сроки (KPI раздела 5).
  @@index([deletedAt, dueDate])
  // «Кто сколько внёс» — срез по сотруднику.
  @@index([createdById])
  // Волна 6: платежи по договору.
  @@index([contractId])
  // KPI «своевременность»: JOIN Contract → Payment по contractId с фильтром
  // status='APPROVED' и range по paidAt. Существующий @@index([contractId])
  // НЕ удаляем (db push сделал бы реальный DROP INDEX, а выигрыш нулевой).
  @@index([contractId, status, paidAt])
}

// ПЛАН по этапу: индивидуальные суммы и сроки договора. Отдельная сущность,
// потому что план существует ДО первого факта (график виден сразу после
// подписания договора) и потому что один этап может быть оплачен частями —
// хранить план на строке факта означало бы дублировать и рассинхронизировать его.
// Волна 6 перевесит владение планом на Contract через тот же contractId.
// Этап 4 (LIVING_EXPENSES) строки здесь НЕ имеет: у расходов на месте плана нет.
model PaymentSchedule {
  id String @id @default(uuid())

  studentId String
  // onDelete: Restrict — та же причина, что у Payment.student выше: план
  // оплат не должен беззвучно исчезнуть при гипотетическом физическом
  // удалении студента.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  contractId String?
  contract   Contract? @relation("ContractSchedule", fields: [contractId], references: [id], onDelete: Restrict)

  stage      PaymentStage
  stageOrder Int          @default(0)

  // 0 = «сумма ещё не согласована»; строка создаётся сразу для всех этапов
  // графика, чтобы UI показывал полную шкалу с самого начала.
  plannedAmount Decimal   @default(0) @db.Decimal(12, 2)
  currency      String    @default("TJS")
  dueDate       DateTime?

  comment String?

  // Кто последний менял плановую сумму/срок — финансовый контроль.
  updatedById String?
  updatedBy   User?   @relation("PaymentScheduleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Один этап у студента = одна плановая строка. Конфликта с soft-delete нет:
  // строки графика не удаляются (обнуляется plannedAmount), а сервис работает
  // через upsert по [studentId, stage] — он же «воскрешает» deletedAt в null.
  @@unique([studentId, stage])
  @@index([studentId, deletedAt, stageOrder])
  @@index([deletedAt, dueDate])
  @@index([contractId])
}

// =====================================================================
// Раздел 3 ТЗ (волна 3): база консультаций/собеседований + планировщик.
// =====================================================================

// ТЗ 3.2 различает «очную консультацию» и «собеседование»: разные события,
// разная длительность, разный смысл в отчётности.
// Здесь enum, а НЕ String (в отличие от Application.source): набор закрыт
// самим ТЗ и меняться не будет, а таблица НОВАЯ — создание типа с нуля не
// трогает ни одной живой строки, значит риск `db push` нулевой.
enum ConsultationKind {
  CONSULTATION
  INTERVIEW
}

// «Решение клиента», которое менеджер фиксирует ПОСЛЕ повторного звонка —
// ради этого ТЗ 3.2 и требует автозадачу («для уточнения решения клиента»).
// null = решение ещё не зафиксировано, звонок не состоялся.
enum ConsultationOutcome {
  THINKING // думает, нужен ещё один контакт
  AGREED // согласен, оформляем заявку
  REFUSED // отказ
  UNREACHABLE // не дозвонились
}

// ТЗ 3.2 — «База данных консультаций и собеседований».
// ОТДЕЛЬНАЯ модель, а не статус у Application. Три причины:
//  1) Application — позиция в ВОРОНКЕ (NEW→…→ENROLLED). На каждую смену
//     статуса applications.service шлёт клиенту SMS и считает STAGE_ORDER;
//     фиктивный статус CONSULTATION сломал бы и рассылку, и аналитику.
//  2) Консультация — СОБЫТИЕ, их у одного человека несколько: до заявки,
//     между этапами и после зачисления. «Одна консультация = одна заявка»
//     раздула бы список заявок и все существующие счётчики.
//  3) У Application поле `direction` ОБЯЗАТЕЛЬНОЕ, а пришедший в офис человек
//     направление ещё не выбрал. Пришлось бы либо писать фиктивное значение,
//     либо ослаблять обязательное поле на 229 живых строках.
model Consultation {
  id String @id @default(uuid())

  // Три поля, которые ТЗ 3.2 требует фиксировать явно.
  fullName String
  phone    String
  purpose  String // «цель обращения» — свободный текст, менеджер пишет как сказал клиент

  // Тот же нормализованный ключ, что у Application.phoneNormalized. По нему
  // собирается история обращений человека, у которого ещё нет ни заявки,
  // ни карточки студента. Только для ЧТЕНИЯ истории — автосклейки по нему нет.
  phoneNormalized String?

  kind         ConsultationKind     @default(CONSULTATION)
  outcome      ConsultationOutcome?
  // Источник привлечения — тот же справочник, что у заявки (common/lead-source.ts).
  source       String?
  sourceDetail String?
  // Направление, если человек уже определился. Опционально — на консультации
  // его часто ещё нет; при конвертации в заявку переносится как есть.
  direction    Direction?
  comment      String?

  // Когда консультация ФАКТИЧЕСКИ проведена. Отдельно от createdAt: менеджер
  // вносит вчерашнюю встречу сегодня, а отчёт «сколько консультаций за неделю»
  // обязан считаться по факту, а не по моменту ввода в CRM. Та же причина,
  // по которой у Payment есть paidAt отдельно от createdAt.
  heldAt DateTime @default(now())

  // Ответственный менеджер — ЕМУ уходит автозадача на повторный звонок.
  managerId   String?
  manager     User?   @relation("ConsultationManager", fields: [managerId], references: [id], onDelete: SetNull)
  // Кто внёс запись: администратор может зафиксировать встречу за менеджера.
  // Тот же раздельный учёт «исполнитель/автор», что у Payment.createdBy/submittedBy.
  createdById String?
  createdBy   User?   @relation("ConsultationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Обе связи ОПЦИОНАЛЬНЫ и обе могут быть заполнены одновременно.
  // Человек «с улицы» не имеет ни заявки, ни студента — это нормальное
  // состояние данных, а не дефект. Связь ставится ТОЛЬКО явным действием
  // («Создать заявку из консультации») либо переносится там, где она уже
  // доказана (заявка получила studentId → её консультации получают тот же).
  // По совпадению телефона связь не проставляется НИКОГДА: в Таджикистане
  // один номер регулярно принадлежит семье, автосклейка объединила бы брата
  // с сестрой и увела бы чужую карточку не тому менеджеру.
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  studentId     String?
  student       Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Волна 7: фактические звонки по этой консультации (замыкает петлю ТЗ 3.2
  // «повторный звонок назначен» → «звонок сделан»). В волне 4 записей нет.
  calls Call[]

  // ТЗ 3.2 — дата и время ПОВТОРНОГО ЗВОНКА.
  followUpAt     DateTime?
  // Автозадача, созданная СИНХРОННО при сохранении консультации. Связь 1:1,
  // поэтому FK помечен @unique. FK живёт здесь, а не на Task: Task — общая
  // таблица всего проекта, навешивать на неё по FK под каждую будущую
  // сущность-источник нельзя, у неё один универсальный ключ — originKey.
  followUpTaskId String?   @unique
  followUpTask   Task?     @relation("ConsultationFollowUpTask", fields: [followUpTaskId], references: [id], onDelete: SetNull)
  // Флаг идемпотентности для планировщика: напоминание «сегодня звонок»
  // уходит РОВНО ОДИН РАЗ. Джоба сначала атомарно занимает строку
  // (updateMany where { id, reminderSentAt: null } → count === 1 значит «моё»),
  // и только потом шлёт уведомление. Два инстанса не отправят его дважды.
  reminderSentAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Главный список раздела: WHERE deletedAt IS NULL ORDER BY heldAt DESC
  // (+ фильтр по датам heldAt BETWEEN — range по последней колонке).
  @@index([deletedAt, heldAt(sort: Desc)])
  // Вкладка «Мои» и фильтр по ответственному менеджеру (ТЗ 3.1, тот же набор).
  @@index([deletedAt, managerId, heldAt(sort: Desc)])
  // История обращений по номеру — блок в карточке заявки/студента.
  @@index([phoneNormalized, heldAt(sort: Desc)])
  // Таймлайн консультаций внутри карточки заявки/студента.
  @@index([applicationId])
  @@index([studentId])
  // Планировщик, джоба напоминаний:
  // WHERE deletedAt IS NULL AND reminderSentAt IS NULL AND followUpAt <= ?
  @@index([deletedAt, reminderSentAt, followUpAt])
}

// Состояние планировщика (@nestjs/schedule). Одна строка на джобу, 3–5 строк
// всего. Таблица нужна НЕ для корректности — идемпотентность обеспечена на
// уровне данных (Task.originKey @unique, Consultation.reminderSentAt,
// updateMany с условием) — а для двух вещей:
//  1) ЗАХВАТ РАБОТЫ между несколькими инстансами Railway БЕЗ Redis. Атомарный
//     compare-and-swap одним запросом:
//       updateMany({ where: { job, OR: [{ running: false },
//                                       { lockedAt: { lt: staleCutoff } }] },
//                    data:  { running: true, lockedAt: now, lockedBy: instanceId } })
//     Под READ COMMITTED второй инстанс блокируется на той же строке,
//     после коммита первого перечитывает её, не проходит по WHERE и получает
//     count = 0 → тихо выходит. Никаких advisory-локов и raw SQL.
//  2) НАБЛЮДАЕМОСТЬ: Основатель видит на GET /scheduler/status, что планировщик
//     жив, когда был последний успешный прогон и какая была последняя ошибка.
// lockedAt + порог протухания решают падение контейнера посреди прогона:
// running останется true, но через STALE_LOCK_MS работу можно перезахватить.
// deletedAt тут нет намеренно: это операционное состояние процесса, а не
// бизнес-данные; строки только upsert'ятся и никогда не удаляются.
model SchedulerRun {
  id String @id @default(uuid())

  // ScheduledJob.name — стабильный идентификатор джобы в коде.
  job String @unique

  running  Boolean   @default(false)
  lockedAt DateTime?
  // Кто держит работу: RAILWAY_REPLICA_ID либо hostname+pid. Нужен, чтобы в
  // логах было видно, какой инстанс подвис.
  lockedBy String?

  lastRunAt DateTime?
  lastOkAt  DateTime?
  lastError String?

  // Счётчики последнего прогона — отдаются в /scheduler/status.
  lastCreated Int @default(0)
  lastSkipped Int @default(0)
  runs        Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Индексов кроме @unique(job) нет НАМЕРЕННО: в таблице 3–5 строк, любой
  // дополнительный индекс здесь только замедлил бы запись при каждом тике.
}

// =====================================================================
// Раздел 4 ТЗ (волна 4): реестр студентов с «двойным грантом» (Multi-Grant).
// =====================================================================

// Набор, с которого стартует учебный год. В Китае это сентябрь, но февральский
// набор существует и у нас есть такие студенты. Поле ВЫЧИСЛЯЕТСЯ СЕРВИСОМ из
// startDate при каждой записи startDate и руками не редактируется — поэтому
// разъехаться с датой не может.
// Зачем вообще хранить производное значение: Prisma не умеет фильтровать по
// EXTRACT(MONTH FROM ...) без $queryRaw, а raw SQL в проекте нет ни одного.
// Тот же приём уже применён в проекте к Payment.stageOrder.
// enum, а не String (в отличие от Application.source): набор закрыт реальностью
// (два набора в году + «прочее»), а таблица НОВАЯ — CREATE TYPE с нуля не
// трогает ни одной живой строки, риск db push нулевой.
enum GrantIntake {
  SEPTEMBER
  FEBRUARY
  OTHER
}

// Состояние гранта, а НЕ состояние студента (Student.status — про человека:
// ACTIVE/PAUSED/GRADUATED/ARCHIVED). Разделены намеренно: студент может быть
// ACTIVE, а грант уже TERMINATED (лишили за неуспеваемость) — и наоборот,
// студент в PAUSED (академ), а грант жив и в сентябре продолжится.
// Джоба напоминаний работает ТОЛЬКО со status = ACTIVE.
enum GrantStatus {
  ACTIVE // действует, годы впереди ещё есть
  SUSPENDED // приостановлен (академотпуск, спор с вузом) — напоминания молчат
  COMPLETED // отучился все totalYears
  TERMINATED // прекращён досрочно (отчисление, отказ, лишение)
}

// ТЗ 4 — «отдельная категория базы данных» для студентов с грантом,
// пролонгированным на 2-й и последующие годы.
//
// ОТДЕЛЬНАЯ ТАБЛИЦА, а не поля в Student:
//  1) у одного человека грантов бывает НЕСКОЛЬКО и подряд (языковой год по
//     одному гранту, затем бакалавриат по другому) — это и есть «двойной
//     грант» в лексике агентства, плоские поля вместили бы ровно один;
//  2) УТЕЧКА В ЛИЧНЫЙ КАБИНЕТ: student-auth.service.ts читает студента через
//     `include: STUDENT_INCLUDE`, а include тянет ВСЕ скаляры модели — любое
//     новое скалярное поле Student автоматически уехало бы студенту в
//     /student-auth/me. Поля отдельной таблицы через include не подтягиваются
//     никогда, пока их явно не попросят;
//  3) реестр — отдельный экран со своими фильтрами/сортировкой, вешать
//     индексы под него на Student (главный список CRM) — лишняя плата записью;
//  4) джоба планировщика сканирует маленькую таблицу реестра, а не всех студентов.
//
// ПРИЗНАК «ДВОЙНОГО ГРАНТА» — ВЫЧИСЛЯЕМЫЙ: totalYears > 1. Отдельного булева
// флага НЕТ намеренно: флаг и число — два источника истины про один факт и
// разъедутся в первый же месяц. Число нужно автоматизации в любом случае —
// оно знает, КОГДА ПЕРЕСТАТЬ напоминать.
model StudentGrant {
  id String @id @default(uuid())

  studentId String
  // onDelete: Restrict — та же семантика, что у Document/Payment/PaymentSchedule.
  // Физического удаления студента в проекте нет, но если оно когда-нибудь
  // появится, реестр грантов должен уронить операцию ошибкой БД, а не
  // беззвучно исчезнуть.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Название/тип гранта как его называет вуз: «CSC Type A», «Стипендия
  // провинции Хэнань», «Грант университета». Свободный текст, а не справочник.
  name       String?
  // Вуз, ВЫДАВШИЙ грант. Снимок, а не ссылка на Program: программа у студента
  // может смениться, а факт «грант дал этот вуз» — исторический.
  university String?

  // Сколько лет обучения покрывает грант. 1 = разовый (в реестр «двойных» не
  // попадает и напоминаний не порождает).
  totalYears  Int @default(1)
  // Какой год обучения идёт СЕЙЧАС, 1-based. Двигается ТОЛЬКО явным действием
  // человека (POST /grants/:id/advance), а не автоматически по календарю:
  // грант могли не продлить (не сдал сессию, лишили), и CRM не имеет права
  // записать факт, которого не было.
  currentYear Int @default(1)

  // Старт ПЕРВОГО учебного года по гранту. Иммутабелен по смыслу (правится
  // только как исправление ошибки ввода). Семантика — КАЛЕНДАРНАЯ ДАТА:
  // сервис приводит её к 00:00 по Душанбе (APP_TZ_OFFSET_MINUTES из
  // scheduler/time.ts).
  startDate DateTime
  // Производное от месяца startDate, считает сервис (см. комментарий к enum).
  intake    GrantIntake @default(SEPTEMBER)

  // ГЛАВНОЕ ПОЛЕ АВТОМАТИЗАЦИИ: плановая дата старта СЛЕДУЮЩЕГО учебного
  // года. Денормализация вынужденная: Prisma не умеет ни арифметику дат в
  // WHERE, ни сравнение двух колонок между собой без $queryRaw (которого в
  // проекте нет вовсе). Обычная индексируемая колонка превращает выборку
  // джобы в один range-скан.
  //
  // ИНВАРИАНТ (держит сервис на КАЖДОЙ записи):
  //   nextYearStartsAt IS NOT NULL  ⟺  status = ACTIVE И currentYear < totalYears.
  // При переводе на следующий год новое значение считается ЦЕПОЧКОЙ:
  // next_new = next_old + 1 год (а не «startDate + N лет») — если вуз сдвинул
  // старт второго года на две недели, сдвиг обязан унаследоваться третьим годом.
  nextYearStartsAt DateTime?

  // Флаг идемпотентности планировщика — тот же приём, что Consultation.reminderSentAt:
  // джоба сначала атомарно ЗАНИМАет строку (updateMany where { id, reminderSentAt: null }
  // → count === 1 значит «моя»), и только потом создаёт задачу. Сбрасывается
  // сервисом в null при каждом изменении nextYearStartsAt и при переводе на
  // следующий год — новый срок = новый цикл напоминания.
  // ВТОРОЙ, независимый слой защиты от дублей — Task.originKey @unique.
  reminderSentAt DateTime?

  status GrantStatus @default(ACTIVE)
  // Условия продления (нужный GPA, требования вуза), договорённости.
  note   String?

  // Кто завёл грант в реестр. SetNull — уволенного сотрудника soft-удаляют,
  // запись остаётся. Используется ещё и как ФОЛБЭК-исполнитель автозадачи,
  // если у студента нет менеджера.
  createdById String?
  createdBy   User?   @relation("StudentGrantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Блок «Грант» в карточке студента.
  @@index([studentId])
  // ОДИН индекс на два сценария:
  //  а) джоба: deletedAt IS NULL AND status='ACTIVE' AND nextYearStartsAt BETWEEN ?;
  //  б) реестр: та же голова + ORDER BY nextYearStartsAt.
  @@index([deletedAt, status, nextYearStartsAt])
}

// =====================================================================
// Раздел 6.3 ТЗ (волна 4): комментарии как СОБЫТИЯ ленты активности.
// =====================================================================

// По умолчанию комментарий ВНУТРЕННИЙ — это заметка менеджера, а не сообщение
// студенту. В волне 4 API значение не принимает и не отдаёт — DTO его не
// содержит, эндпоинтов комментариев в личном кабинете нет вовсе.
enum CommentVisibility {
  INTERNAL
  STUDENT_VISIBLE
}

// ТЗ 6.3 — «добавление текстовых комментариев» как события ленты.
//
// Почему НЕ расширение Student.comment/Application.comment: там ОДНА строка
// без автора и без времени, второй комментарий затирает первый. Лента
// требует истории — значит нужна строка на комментарий.
// Существующие поля НЕ ТРОГАЕМ и НЕ ПЕРЕНОСИМ: в Application.comment лежит
// сообщение клиента с лендинга, в Student.comment — заметка менеджера. В UI
// старое поле остаётся отдельным блоком НАД лентой.
//
// СВЯЗЬ — ДВЕ NULLABLE-ССЫЛКИ, А НЕ ПОЛИМОРФИЗМ (entityType+entityId): тот же
// паттерн, что уже есть и работает — Consultation.applicationId? + studentId?.
// ИНВАРИАНТ (держит сервис, CHECK в Prisma не выражается): заполнена хотя бы
// одна из ссылок.
model Comment {
  id String @id @default(uuid())

  // Текст. Длина режется в DTO (@MaxLength(4000)) — в ActivityLog.details
  // уезжает только превью ~200 символов.
  body String

  studentId String?
  // Restrict, а не SetNull: комментарий — часть аудит-следа. Комментарий,
  // потерявший якорь, не виден ни в одной ленте — тихая потеря данных.
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  // Автор. Nullable + SetNull для единообразия со всей схемой (Payment.createdBy).
  authorId String?
  author   User?   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  visibility CommentVisibility @default(INTERNAL)

  // Отметка «отредактирован» — лента обязана честно показывать, что текст
  // меняли после публикации. Сам исходный текст остаётся в ActivityLog.
  editedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Лента в карточке студента: WHERE studentId=? AND deletedAt IS NULL
  // ORDER BY createdAt DESC — сортировка из индекса.
  @@index([studentId, deletedAt, createdAt(sort: Desc)])
  // То же в карточке заявки.
  @@index([applicationId, deletedAt, createdAt(sort: Desc)])
  // «Что писал этот сотрудник» — срез для Основателя.
  @@index([authorId, createdAt(sort: Desc)])
}

// =====================================================================
// Раздел 6.3 ТЗ — ЗАГОТОВКА ПОД IP-ТЕЛЕФОНИЮ (волна 7).
// В ЭТОЙ ВОЛНЕ ЗАПИСЕЙ НЕ СОЗДАЁТСЯ НИ ОДНОЙ: эндпоинтов записи нет, сидов
// нет, фикстур нет. Таблица заводится сейчас, чтобы волна 7 добавила ТОЛЬКО
// адаптер провайдера и вебхук, не трогая схему на живой базе.
// =====================================================================

// INTERNAL (звонок между сотрудниками) сознательно НЕ заводим: он не нужен
// ни одному отчёту ТЗ. Добавление значения в pg-enum — безопасная операция
// для db push, поэтому расширить набор волна 7 сможет без миграции данных.
enum CallDirection {
  INBOUND
  OUTBOUND
}

// Надмножество исходов, которые отдают IP-АТС. Провайдер ещё не выбран,
// поэтому набор сознательно шире, чем нужно сегодня — всё, что не свелось,
// переживает в Call.raw без потери информации.
enum CallStatus {
  COMPLETED // разговор состоялся
  NO_ANSWER // не ответили
  BUSY // занято
  FAILED // техническая ошибка/недоступен
  CANCELED // отменён до соединения
  VOICEMAIL // ушёл на автоответчик
}

model Call {
  id String @id @default(uuid())

  // Имя провайдера. String, а не enum: провайдер НЕ ВЫБРАН. 'MANUAL' —
  // звонок, зафиксированный менеджером руками (если такой эндпоинт появится
  // — НЕ в этой волне).
  provider   String  @default("MANUAL")
  // Идентификатор звонка НА СТОРОНЕ ПРОВАЙДЕРА. Ключ идемпотентности вебхука.
  // Составной @@unique с provider — NULL'ы в Postgres в уникальном индексе
  // между собой не конфликтуют, ручные звонки без externalId проходят как есть.
  externalId String?

  direction CallDirection
  status    CallStatus    @default(COMPLETED)

  // Номер СОБЕСЕДНИКА (клиента) в том виде, как его отдал провайдер.
  phone           String
  // Тот же ключ склейки, что у Application.phoneNormalized/Consultation.phoneNormalized.
  line            String? // номер/линия агентства, на которую пришёл или с которой ушёл звонок
  phoneNormalized String?

  // Три момента: длительность СОЕДИНЕНИЯ и длительность ОЖИДАНИЯ — разные
  // метрики (KPI раздела 5 считается именно по answeredAt − startedAt).
  startedAt   DateTime
  answeredAt  DateTime?
  endedAt     DateTime?
  // Длительность РАЗГОВОРА в секундах, денормализована — любая АТС отдаёт
  // её готовой.
  durationSec Int       @default(0)

  // Ссылка на запись У ПРОВАЙДЕРА. В /uploads в этой волне ничего не
  // скачивается — хранение записей разговоров решает Основатель отдельно.
  recordingUrl String?

  // Сотрудник на внутренней линии. SetNull — как везде в схеме.
  userId String?
  user   User?   @relation("CallUser", fields: [userId], references: [id], onDelete: SetNull)

  // Три опциональные привязки, как у Comment/Consultation. Звонок с
  // неизвестного номера не привязан ни к кому — нормальное состояние данных.
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  // Замыкает петлю ТЗ 3.2: «повторный звонок назначен» → «звонок сделан».
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  // Итог разговора словами менеджера (не транскрипция).
  comment String?
  // СЫРОЙ payload вебхука. Провайдер не выбран — поля неизвестны заранее.
  // ВНИМАНИЕ ДЛЯ ВОЛНЫ 7: raw содержит PII и НЕ ОТДАЁТСЯ наружу — ни
  // студенту, ни EMPLOYEE; только FOUNDER и только явным запросом.
  raw     Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Один звонок = одна строка, повторная доставка вебхука отбивается БД.
  @@unique([provider, externalId])
  // Блок «Звонки» в карточке студента.
  @@index([studentId, deletedAt, startedAt(sort: Desc)])
  // То же в карточке заявки.
  @@index([applicationId, startedAt(sort: Desc)])
  // «Сколько звонков сделал сотрудник за период» — KPI раздела 5.
  @@index([userId, startedAt(sort: Desc)])
  // Сшивка с историей обращений по номеру.
  @@index([phoneNormalized])
  // Общий журнал звонков за период.
  @@index([deletedAt, startedAt(sort: Desc)])
}

// =====================================================================
// РАЗДЕЛ 5 ТЗ (волна 6): договоры, KPI менеджеров, зарплата.
// Всё ниже — НОВЫЕ таблицы: CREATE TABLE/CREATE TYPE не трогает ни одной
// живой строки, риск `prisma db push --accept-data-loss` нулевой.
// =====================================================================

// Состояние ДОГОВОРА. Отдельный статус, а НЕ «есть запись = подписан»:
//  1) договор готовится ДО подписания (согласуются суммы этапов, уже надо
//     заполнить PaymentSchedule) — это DRAFT, и он не должен попадать
//     ни в конверсию, ни в бонус;
//  2) расторжение: правило проекта №1 запрещает удалять — значит нужно
//     СОСТОЯНИЕ, а не отсутствие строки;
//  3) у подписания обязана быть ДАТА, а дату из факта существования строки
//     не вывести (createdAt — это «когда завели в CRM», а не «когда подписали»).
enum ContractStatus {
  DRAFT // готовится; в KPI и зарплате НЕ участвует
  SIGNED // подписан — единственное состояние, дающее конверсию и бонус
  TERMINATED // расторгнут (возврат бонуса — через Payslip.adjustmentAmount, не пересчётом)
  COMPLETED // исполнен: все этапы оплачены, студент уехал
}

model Contract {
  id String @id @default(uuid())

  // Человекочитаемый номер («ДГ-2026-0042»), генерирует сервис. @unique —
  // номер договора уникален в делопроизводстве, дубль = юридическая проблема.
  number String @unique

  // Договор всегда заключается с УЖЕ заведённым студентом: Payment.studentId
  // NOT NULL, PaymentSchedule @@unique([studentId, stage]) — без карточки
  // студента графику платежей не на чем держаться.
  // Restrict — как у Payment.student: финансовый документ не должен беззвучно
  // исчезнуть при гипотетическом физическом удалении студента.
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Заявка-источник — ТОЛЬКО для атрибуции конверсии «лид → договор».
  // НЕ @unique намеренно: расторгли и подписали заново по той же заявке —
  // это два договора. Двойной счёт в CR снимается COUNT(DISTINCT "applicationId").
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  // ОТВЕТСТВЕННЫЙ ЗА ДОГОВОР — тот, кому пойдёт бонус. ОТДЕЛЬНОЕ поле, а не
  // чтение student.managerId на лету: если студента переназначат в октябре,
  // бонус за сентябрьский договор не имеет права переехать другому человеку.
  // Заполняется при создании из manager заявки/студента; после SIGNED меняется
  // только Основателем и только с записью в ActivityLog.
  // Restrict, а не SetNull (в отличие от Application.manager): договор без
  // ответственного молча ломает всю зарплатную атрибуцию. Физического удаления
  // User в проекте нет (только soft-delete), увольнению это не мешает.
  managerId String?
  manager   User?   @relation("ContractManager", fields: [managerId], references: [id], onDelete: Restrict)

  status ContractStatus @default(DRAFT)

  // МОМЕНТ «ПОДПИСАН». Инвариант держит сервис (CHECK в Prisma не выражается):
  // status = SIGNED ⟺ signedAt IS NOT NULL ⟺ activeSlot = 'ACTIVE'.
  // Отдельная дата, а не createdAt: менеджер вносит вчерашний договор сегодня —
  // та же причина, по которой есть Payment.paidAt и Consultation.heldAt.
  // ВСЕ метрики раздела 5 считаются по signedAt.
  signedAt   DateTime?
  signedById String?
  signedBy   User?     @relation("ContractSignedBy", fields: [signedById], references: [id], onDelete: SetNull)

  // ГАРАНТИЯ БД «не больше одного ДЕЙСТВУЮЩЕГО договора у студента».
  // Приём с NULL'ами уже узаконен в проекте (Task.originKey, Call.provider+externalId):
  // NULL'ы в уникальном индексе Postgres между собой не конфликтуют, поэтому
  // черновиков и расторгнутых может быть сколько угодно, а SIGNED — ровно один.
  // Зачем: PaymentSchedule уникален по [studentId, stage], график платежей
  // физически ОДИН на студента. Два «действующих» договора молча разделили бы
  // деньги одного графика между двумя менеджерами и двумя бонусами.
  // 'ACTIVE' пока status = SIGNED, иначе null. Ставится той же updateMany, что и статус.
  activeSlot String?

  terminatedAt      DateTime?
  terminatedById    String?
  terminatedBy      User?     @relation("ContractTerminatedBy", fields: [terminatedById], references: [id], onDelete: SetNull)
  terminationReason String?

  // Сумма ПО БУМАГЕ. Отдельно от суммы этапов (PaymentSchedule): в договоре
  // может стоять договорная цифра со скидкой, а разбивка по этапам —
  // операционная. Расхождение показываем в UI, но не «чиним» автоматически.
  amount   Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("TJS")

  // ВЕХА «ПЕРЕЕЗД» (метрика ТЗ 5.1 «доведение до этапа переезда»).
  // Живёт на договоре, а НЕ на Student: любое новое СКАЛЯРНОЕ поле Student
  // автоматически уезжает студенту в /student-auth/me (там include, а не
  // select — прямо задокументировано у StudentGrant). Contract в кабинет
  // студента не отдаётся вовсе.
  // Ставится ОДИН РАЗ claim-апдейтом (updateMany where { id, relocatedAt: null })
  // при одобрении платежа этапа RELOCATION. Необратима: откат статуса или VOID
  // платежа её НЕ обнуляют — «дошёл хотя бы раз» это факт истории.
  relocatedAt DateTime?

  note String?

  createdById String?
  createdBy   User?   @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  payments  Payment[]         @relation("ContractPayments")
  schedule  PaymentSchedule[] @relation("ContractSchedule")
  documents Document[]        @relation("ContractDocuments")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([studentId, activeSlot])
  @@index([studentId, deletedAt])
  // ГЛАВНЫЙ индекс KPI: «договоры менеджера, подписанные в периоде» —
  // числитель конверсии и база бонусов PERCENT_OF_CONTRACTS / FIXED_PER_CONTRACT.
  // deletedAt зафиксирован IS NULL, managerId — равенство, signedAt — range.
  @@index([deletedAt, managerId, signedAt])
  // «Доведён до переезда за период» — метрика ТЗ 5.1 и FIXED_PER_RELOCATION.
  @@index([deletedAt, managerId, relocatedAt])
  // Реестр договоров руководства: WHERE deletedAt IS NULL [AND status] ORDER BY signedAt DESC.
  @@index([deletedAt, status, signedAt(sort: Desc)])
  // Атрибуция конверсии: договор по заявке-источнику.
  @@index([applicationId])
}

// ОКЛАД — ОТДЕЛЬНАЯ ТАБЛИЦА С ИСТОРИЕЙ, а не поле в User. Три причины:
//  1) оклад меняется во времени. Поле в User хранит только «сейчас» —
//     пересчёт марта после апрельского повышения выдал бы новую сумму;
//  2) УТЕЧКА: в проекте есть запросы вида prisma.user.findFirst({ where })
//     БЕЗ select (consultations.service.resolveManagerId, tasks.service) —
//     они тянут ВСЕ скаляры User. Сегодня туда попадает только password
//     (наружу не отдаётся), завтра туда же попал бы оклад, и одна неосторожная
//     отдача объекта наружу раскрыла бы зарплаты всем;
//  3) отдельная таблица = отдельная граница доступа (@Roles(FOUNDER)) и
//     собственный аудит, а не «ещё одно поле в общей модели».
// effectiveTo НЕТ намеренно: он выводится из следующей записи, а два
// источника истины про один факт разъезжаются (тот же довод, что у
// StudentGrant — «флаг и число»).
model EmployeeCompensation {
  id String @id @default(uuid())

  userId String
  // Restrict — денежный документ: ставка не должна исчезнуть вместе с
  // гипотетическим физическим удалением сотрудника.
  user   User   @relation("CompensationEmployee", fields: [userId], references: [id], onDelete: Restrict)

  baseSalary Decimal @db.Decimal(12, 2)
  currency   String  @default("TJS")

  // ДАТА начала действия. Семантика — календарная дата (сервис приводит к
  // 00:00 по Душанбе, APP_TZ_OFFSET_MINUTES из scheduler/time.ts).
  // ПРАВИЛО ВЫБОРА СТАВКИ НА ПЕРИОД: последняя запись с
  // effectiveFrom <= periodStart. Повышение «с середины месяца» оформляется
  // первым числом следующего — пропорционального расчёта в системе НЕТ
  // намеренно (одноразовый случай закрывается Payslip.baseOverride).
  effectiveFrom DateTime

  note String?

  createdById String?
  createdBy   User?   @relation("CompensationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Две ставки одному человеку с одной датой — всегда ошибка ввода, ловим в БД.
  @@unique([userId, effectiveFrom])
  // «Действующая ставка на дату»: WHERE userId=? AND effectiveFrom <= ?
  // ORDER BY effectiveFrom DESC LIMIT 1 — сортировка берётся из индекса.
  @@index([userId, effectiveFrom(sort: Desc)])
  @@index([deletedAt])
}

// ВЕРСИЯ набора правил бонусов. Изменение формул = создание НОВОЙ версии,
// НИКОГДА не UPDATE действующей: иначе правка в середине месяца молча
// переписала бы уже посчитанные начисления всем сразу.
enum BonusRuleSetStatus {
  DRAFT // готовится/симулируется, в расчёте не участвует
  ACTIVE // применяется к периодам с effectiveFrom и далее
  ARCHIVED // вытеснена более новой версией
}

model BonusRuleSet {
  id String @id @default(uuid())

  // Номер версии для человека («v3»), ставит сервис = max+1. @unique, чтобы
  // в разговоре «посчитано по v3» значило ровно одно.
  version Int    @unique
  title   String

  status BonusRuleSetStatus @default(DRAFT)

  // Первый день месяца, с которого версия применяется. ВЫБОР ВЕРСИИ ДЛЯ
  // ПЕРИОДА: последняя ACTIVE с effectiveFrom <= periodStart. Поэтому набор,
  // активированный в середине месяца «со следующего», физически не может
  // повлиять на текущий расчёт.
  effectiveFrom DateTime

  createdById   String?
  createdBy     User?     @relation("BonusRuleSetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  activatedAt   DateTime?
  activatedById String?
  activatedBy   User?     @relation("BonusRuleSetActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)

  rules BonusRule[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // «Какая версия действует на дату» — один индексный скан.
  @@index([deletedAt, status, effectiveFrom(sort: Desc)])
}

// ТИПЫ БОНУСОВ. КАЖДЫЙ — ЗАКРЫТАЯ СТРУКТУРА С ЧИСЛОВЫМИ ПАРАМЕТРАМИ.
// НИКАКИХ строк, интерпретируемых как код: движок — обычный switch по kind
// в payroll/bonus-engine.ts. eval/new Function/vm/шаблонизаторы ЗАПРЕЩЕНЫ
// (это прямой RCE от лица администратора).
enum BonusRuleKind {
  PERCENT_OF_CONTRACTS // rate × Σ Contract.amount подписанных за период
  PERCENT_OF_PAYMENTS // rate × Σ APPROVED-платежей по договорам менеджера [× фильтр stage]
  FIXED_PER_CONTRACT // amount × количество подписанных договоров
  FIXED_PER_STAGE // amount × количество этапов (stage), полностью закрытых за период
  FIXED_PER_ENROLLMENT // amount × количество доведённых до зачисления
  FIXED_PER_RELOCATION // amount × количество доведённых до переезда
  FIXED_PER_CONSULTATION // amount × количество проведённых консультаций
  KPI_THRESHOLD_BONUS // премия, если metric >= threshold: amount ЛИБО rate × оклад
}

// Метрика для KPI_THRESHOLD_BONUS. Значения = ровно те, что считает
// payroll/kpi.service.ts. Расширяется append'ом без миграции данных.
enum KpiMetric {
  LEADS_PROCESSED
  CONSULTATIONS_HELD
  CONTRACTS_SIGNED
  CONVERSION_RATE // доля 0..1
  PAYMENT_TIMELINESS // доля 0..1
  DELIVERY_RATE // доля 0..1
  ENROLLED_COUNT
  RELOCATED_COUNT
}

// ТЗ 5.1 требует «индивидуальные И командные показатели»: порог проверяется
// либо по личной метрике сотрудника, либо по метрике всего отдела за период.
enum BonusMetricScope {
  PERSONAL
  TEAM
}

// Кому правило адресовано: всем (командное правило) или конкретному человеку
// (персональная надбавка). Правила СУММИРУЮТСЯ, персональное не «перекрывает»
// общее — так поведение остаётся предсказуемым без приоритетов и наследования.
enum BonusRuleScope {
  ALL
  USER
}

// ОДНО ПРАВИЛО = ОДНА СТРОКА С ТИПИЗИРОВАННЫМИ ЧИСЛОВЫМИ КОЛОНКАМИ.
// Осознанный отказ от «одна Json-колонка с конфигом»: Json не проверяется БД,
// не индексируется, а diff между версиями по нему нечитаем — а именно diff
// («что изменилось в формулах») Основателю и нужен. Json в проекте
// используется ТОЛЬКО как СНИМОК в Payslip (архив), никогда как источник
// конфигурации.
model BonusRule {
  id String @id @default(uuid())

  ruleSetId String
  ruleSet   BonusRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  kind  BonusRuleKind
  // Подпись строки в расшифровке расчётного листа («3% от суммы договоров»).
  label String

  scope  BonusRuleScope @default(ALL)
  // Заполнено только при scope = USER. Инвариант держит сервис.
  userId String?
  user   User?          @relation("BonusRuleUser", fields: [userId], references: [id], onDelete: Restrict)

  // ── Числовые параметры. Все Decimal, НИКОГДА Float (правило проекта №7). ──
  // Доля, а не проценты: 0.0300 = 3%. UI показывает и принимает %, конвертирует
  // на фронте. Валидация 0..1 в DTO — «процент 300%» не должен доехать до БД.
  rate      Decimal? @db.Decimal(6, 4)
  // Фиксированная сумма в TJS (ставка за этап/договор/консультацию либо премия).
  amount    Decimal? @db.Decimal(12, 2)
  // Порог для KPI_THRESHOLD_BONUS. Одна колонка на счётчики (0..10000) и
  // на доли (0..1), поэтому 12,4.
  threshold Decimal? @db.Decimal(12, 4)
  // ОБЯЗАТЕЛЬНЫЙ предохранитель от опечатки в проценте: потолок вклада ОДНОГО
  // правила в один расчётный лист. Сервис требует его для всех PERCENT_*.
  cap       Decimal? @db.Decimal(12, 2)

  // Для FIXED_PER_STAGE обязателен, для PERCENT_OF_PAYMENTS — необязательный
  // фильтр («3% только с этапа 1»). Переиспользуем существующий enum.
  stage PaymentStage?

  // Для KPI_THRESHOLD_BONUS.
  metric      KpiMetric?
  metricScope BonusMetricScope @default(PERSONAL)
  // Ступенчатая шкала БЕЗ отдельного типа правила и без кода в данных:
  // правила с одинаковым tierGroup конкурируют, применяется РОВНО ОДНО —
  // с наибольшим пройденным threshold. Пример: 60% → 200, 80% → 500, 95% → 1000.
  tierGroup   String?

  enabled   Boolean @default(true)
  sortOrder Int     @default(0)
  note      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Загрузка набора целиком в порядке отображения/расчёта.
  @@index([ruleSetId, deletedAt, sortOrder])
  @@index([userId])
}

// Жизненный цикл расчётного листа. Зеркалит PaymentStatus волны 1:
// после фиксации выплаты правится ТОЛЬКО сторнированием (VOID), не редактированием.
enum PayslipStatus {
  DRAFT // считается и пересчитывается; сотруднику НЕ показывается
  APPROVED // начисление утверждено, состав заморожен
  PAID // выплата зафиксирована, лист полностью иммутабелен
  VOID // аннулирован; в суммах не учитывается, из БД не исчезает
}

model Payslip {
  id String @id @default(uuid())

  userId String
  // Restrict — расчётный лист это денежный документ, он обязан пережить
  // любые операции над карточкой сотрудника (та же семантика, что Payment.student).
  user   User   @relation("PayslipUser", fields: [userId], references: [id], onDelete: Restrict)

  // Границы периода в UTC, ЯВНО сохранённые. Считаются один раз из локального
  // месяца Душанбе (scheduler/time.ts). Хранятся, а не выводятся из periodKey:
  // если завтра поменяется APP_TZ_OFFSET_MINUTES, пересчёт старого листа не
  // должен молча захватить другой набор платежей. Полуинтервал [start, end).
  periodStart DateTime
  periodEnd   DateTime
  // 'YYYY-MM' — человекочитаемый ключ периода, он же участвует в @@unique.
  periodKey   String

  // Номер ревизии. Нужен из-за сторнирования: аннулированный лист остаётся
  // в БД, а исправленный выпускается за ТОТ ЖЕ период — без revision
  // @@unique([userId, periodKey]) сделал бы исправление невозможным.
  revision   Int     @default(1)
  // 'ACTIVE' пока status != VOID, иначе null. Даёт БД-гарантию
  // «не больше одного НЕ аннулированного листа на сотрудника за месяц»,
  // то есть физическую невозможность выплатить дважды за один период.
  activeSlot String?

  status PayslipStatus @default(DRAFT)

  // ── Суммы. Все Decimal(12,2), TJS. ──
  // Оклад периода (снимок EmployeeCompensation на periodStart).
  baseAmount       Decimal  @default(0) @db.Decimal(12, 2)
  // Ручная замена оклада в ЭТОМ листе (сотрудник отработал полмесяца, разовая
  // договорённость). Заполняется только Основателем и только вместе с причиной.
  baseOverride     Decimal? @db.Decimal(12, 2)
  // Бонусная часть: PERCENT_* + FIXED_* правила.
  bonusAmount      Decimal  @default(0) @db.Decimal(12, 2)
  // Премия за KPI — ОТДЕЛЬНОЕ поле: ТЗ 5.2 различает «бонусную часть» и
  // «премию за выполнение KPI», в ведомости это разные колонки.
  kpiBonusAmount   Decimal  @default(0) @db.Decimal(12, 2)
  // Ручная корректировка. МОЖЕТ БЫТЬ ОТРИЦАТЕЛЬНОЙ: возврат бонуса за
  // расторгнутый договор делается здесь, а НЕ пересчётом прошлого периода.
  adjustmentAmount Decimal  @default(0) @db.Decimal(12, 2)
  adjustmentReason String?
  // Хранится, а не вычисляется на лету: выплаченный документ обязан показывать
  // одну и ту же цифру навсегда, даже если завтра поменяется порядок округления.
  totalAmount      Decimal  @default(0) @db.Decimal(12, 2)
  currency         String   @default("TJS")

  // ── СНИМКИ. Ради них модуль и существует. ──
  // Версия правил, по которой посчитано (для отчёта «все листы по v3»).
  ruleSetId       String?
  ruleSetVersion  Int?
  // ПОЛНАЯ копия применённых правил и их параметров. Дублирует ruleSetId
  // НАМЕРЕННО: даже если версию soft-удалят или связь потеряется, лист
  // остаётся самодостаточным документом. Json здесь — АРХИВ, не конфигурация:
  // расчёт его никогда не читает.
  formulaSnapshot Json
  // Все посчитанные метрики периода целиком (включая промежуточные суммы).
  metricsSnapshot Json
  // Построчная расшифровка «правило → база → сумма» — ровно то, что видит
  // сотрудник. Хранится, потому что восстановить её пересчётом уже нельзя.
  breakdown       Json

  // ── Денормализованные метрики для СОРТИРОВКИ ведомости. ──
  // Сортировать ведомость по конверсии, читая jsonb, = seq scan + cast;
  // тот же приём, что Payment.stageOrder.
  leadsProcessed    Int      @default(0)
  consultationsHeld Int      @default(0)
  contractsSigned   Int      @default(0)
  enrolledCount     Int      @default(0)
  relocatedCount    Int      @default(0)
  // null = «нет базы» (знаменатель 0), это НЕ ноль: новый сотрудник без лидов
  // не должен считаться провалившим KPI.
  conversionRate    Decimal? @db.Decimal(6, 4)
  timelinessRate    Decimal? @db.Decimal(6, 4)
  deliveryRate      Decimal? @db.Decimal(6, 4)

  // Итог выбился за предохранитель (например > 3× оклада) — лист создаётся,
  // но помечается, и UI показывает Основателю красный баннер. Защита от
  // опечатки в проценте, которая иначе всплыла бы уже после выплаты.
  needsReview Boolean @default(false)

  calculatedAt   DateTime?
  calculatedById String?
  calculatedBy   User?     @relation("PayslipCalculatedBy", fields: [calculatedById], references: [id], onDelete: SetNull)

  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("PayslipApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  // Фиксация выплаты. paidAt НИКОГДА не обнуляется, даже при последующем
  // VOID — иначе теряется дата проведения для аудита (точно как Payment.approvedAt).
  paidAt        DateTime?
  paidById      String?
  paidBy        User?     @relation("PayslipPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidReference String?

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("PayslipVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?

  // Сторно-цепочка: какой лист заменил этот и какой этот заменяет.
  replacedById String?   @unique
  replacedBy   Payslip?  @relation("PayslipReissue", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     Payslip[] @relation("PayslipReissue")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Идемпотентность генератора: повторный прогон джобы падает с P2002 и
  // молча считается skipped (паттерн A из scheduler/job.contract.ts).
  @@unique([userId, periodKey, revision])
  // «Не больше одного живого листа на период» — гарантия против двойной выплаты.
  @@unique([userId, periodKey, activeSlot])
  // Кабинет сотрудника: WHERE userId=? AND deletedAt IS NULL ORDER BY periodStart DESC.
  @@index([userId, deletedAt, periodStart(sort: Desc)])
  // Ведомость за период: WHERE periodKey=? AND deletedAt IS NULL [AND status].
  @@index([deletedAt, periodKey, status])
}

// =====================================================================
// РАЗДЕЛ «БИЛЕТЫ» (волна 8). Учёт, контроль и планирование перелётов
// студентов. Всё ниже — НОВЫЕ таблицы: CREATE TABLE/CREATE TYPE не трогает
// ни одной живой строки, риск `prisma db push --accept-data-loss` нулевой.
// =====================================================================

// Ровно четыре значения из ТЗ. enum, а НЕ String (в отличие от
// Application.source): набор закрыт самим ТЗ и меняться не будет, а таблица
// НОВАЯ — создание типа с нуля не трогает ни одной живой строки.
enum TicketStatus {
  BOOKED // Забронирован
  PURCHASED // Выкуплен
  CHANGED // Изменён
  CANCELLED // Отменён
}

// ТЗ «Билеты», п.3. ОТДЕЛЬНАЯ модель, а не поля в Student:
//  1) у студента бывает НЕСКОЛЬКО перелётов (вылет, стыковка, обратный,
//     перелёт на второй год обучения) — плоские поля вместили бы один;
//  2) УТЕЧКА В ЛИЧНЫЙ КАБИНЕТ: student-auth.service.ts читает студента через
//     `include: STUDENT_INCLUDE`, а include тянет ВСЕ скаляры модели — любое
//     новое скалярное поле Student автоматически уехало бы студенту в
//     /student-auth/me. Поля отдельной таблицы через include не подтягиваются
//     никогда, пока их явно не попросят (тот же довод, что у StudentGrant);
//  3) раздел — отдельный экран со своими фильтрами и сортировкой, вешать
//     индексы под него на Student (главный список CRM) — лишняя плата записью.
model Ticket {
  id String @id @default(uuid())

  // ТЗ: «Студент — обязательное поле». onDelete: Restrict — та же семантика,
  // что у Document/Payment/StudentGrant: физического удаления студента в
  // проекте нет, но если оно когда-нибудь появится, билет должен уронить
  // операцию ошибкой БД, а не беззвучно исчезнуть.
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // ТЗ: «Город назначения (Китай) — выпадающий список ИЛИ строка».
  // РЕШЕНИЕ ЗАКАЗЧИКА: справочник + свободный ввод. Поэтому в БД это String,
  // а не enum: справочник живёт в common/china-cities.ts и подсказывает
  // менеджеру, но редкий маршрут не блокируется. Тот же приём, что у
  // Application.source — новый город это одна строка в TS-файле, а не
  // ALTER TYPE на живой колонке.
  destinationCity String

  // ТЗ: «Дата и время вылета» — обязательное. Хранится в UTC, как все
  // DateTime схемы. Фронт вводит через <input type="datetime-local"> и шлёт
  // new Date(v).toISOString(): JS трактует datetime-local как ЛОКАЛЬНОЕ время
  // браузера, а браузер менеджера стоит по Душанбе — TZ-математики на сервере
  // для этого пути не нужно вообще (тот же приём, что Task.dueDate).
  departureAt DateTime
  // ТЗ: «Дата и время прилёта» — необязательное (контроль стыковок).
  arrivalAt   DateTime?

  // ТЗ: «Номер рейса» — обязательное, например SU-208.
  flightNumber String
  // ТЗ: «Авиакомпания» — строка/справочник. Строка по той же причине, что и
  // город: список авиакомпаний открытый.
  airline      String?

  status TicketStatus @default(BOOKED)

  // ТЗ: «Комментарий» — «Летит с багажом 23 кг», «Встречает курьер».
  comment String?

  // ТЗ: «Файл билета / Маршрутная квитанция (PDF, JPEG, PNG)». Файлы — обычные
  // Document (type='TICKET', ticketId), поэтому автоматически получают защиту
  // /uploads через files/file-resolver.service.ts (ветка DOCUMENT) — ровно тот
  // же приём, что у чеков платежей и сканов договоров.
  documents Document[] @relation("TicketDocuments")

  // Кто завёл билет. SetNull — уволенного сотрудника soft-удаляют, запись
  // остаётся (та же семантика, что у Payment.createdBy).
  createdById String?
  createdBy   User?   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // ── Автоматизация напоминаний (решение заказчика, сверх ТЗ). ──
  // Флаги идемпотентности планировщика — тот же приём, что
  // Consultation.reminderSentAt и StudentGrant.reminderSentAt: джоба сначала
  // атомарно ЗАНИМАЕТ строку (updateMany where { id, taskCreatedAt: null }
  // → count === 1 значит «моя»), и только потом создаёт задачу/шлёт SMS.
  // Сбрасываются сервисом в null при КАЖДОМ изменении departureAt — новый
  // срок вылета = новый цикл напоминаний (иначе перенос рейса молча убил бы
  // напоминание, как это было с переносом звонка в волне 3).
  // ВТОРОЙ, независимый слой защиты от дублей — Task.originKey @unique.
  taskCreatedAt DateTime?
  smsSentAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ГЛАВНЫЙ индекс списка раздела: WHERE deletedAt IS NULL [AND status]
  // ORDER BY departureAt DESC. Обе ведущие колонки зафиксированы
  // (deletedAt IS NULL, status равенством), поэтому сортировка и фильтр по
  // диапазону дат («на этой неделе», «в этом месяце») берутся из индекса.
  @@index([deletedAt, status, departureAt(sort: Desc)])
  // Список без фильтра по статусу + джоба напоминаний (range по departureAt).
  @@index([deletedAt, departureAt])
  // Блок «Билеты» в карточке студента.
  @@index([studentId, deletedAt, departureAt(sort: Desc)])
  // Фильтр по городу назначения.
  @@index([destinationCity])
}

// =====================================================================
// ТЗ 6.1 (волна 8): БАЗА ЗНАНИЙ + AI-ПОМОЩНИК.
// =====================================================================

// «Внутренние инструкции, регламенты и правила работы CRM», на которых
// «обучен» помощник. РЕШЕНИЕ ЗАКАЗЧИКА: статьи редактируются прямо в CRM,
// а не лежат в репозитории — правка регламента не должна требовать деплоя.
//
// ВАЖНО: это НЕ дообучение модели (fine-tuning), а RAG — статьи подставляются
// в системный промпт запроса. Отсюда два следствия для эксплуатации:
//  1) правка статьи действует НЕМЕДЛЕННО на следующий вопрос, без обучения;
//  2) объём базы ограничен окном контекста, поэтому в промпт уходят только
//     опубликованные статьи (published) — черновики не влияют на ответы.
model KnowledgeArticle {
  id String @id @default(uuid())

  title String
  // Категория — String, а не enum: набор разделов регламента будет расти
  // (тот же довод, что у Application.source). Справочник значений для UI —
  // backend/src/knowledge/knowledge-categories.ts.
  category String @default("GENERAL")
  // Тело статьи в Markdown. Длина режется в DTO (@MaxLength(20000)).
  body     String

  // Ключевые слова для поиска и для подсказки модели, когда статья релевантна.
  tags String[] @default([])

  // Черновик не попадает ни в поиск сотрудников, ни в контекст AI-помощника.
  published Boolean @default(true)
  // Порядок в списке; статьи с меньшим значением идут первыми.
  sortOrder Int     @default(0)

  createdById String?
  createdBy   User?   @relation("KnowledgeArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("KnowledgeArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Список раздела и сборка контекста для AI: WHERE deletedAt IS NULL
  // AND published = true ORDER BY sortOrder, createdAt.
  @@index([deletedAt, published, sortOrder])
  @@index([deletedAt, category])
}

// История чата с AI-помощником. Хранится, потому что ТЗ описывает именно ЧАТ
// («задавать вопросы в текстовом чате»), а чат без истории не понимает
// уточняющих вопросов вида «а если чек не пришёл?».
//
// ПРИВАТНОСТЬ: переписка сотрудника с помощником видна ТОЛЬКО ему самому —
// эндпоинтов чтения чужой истории нет вовсе (userId всегда берётся из JWT,
// как в payroll/me). Это осознанно: сотрудник должен иметь возможность
// спросить «как оформить возврат» без того, чтобы это увидел руководитель.
model AiChatMessage {
  id String @id @default(uuid())

  userId String
  // Restrict, а не Cascade: физического удаления User в проекте нет, а
  // беззвучная потеря истории при гипотетическом удалении — тихая порча данных.
  user   User   @relation("AiChatMessageUser", fields: [userId], references: [id], onDelete: Restrict)

  // 'user' | 'assistant' — String, а не enum: набор ролей задаёт внешний API,
  // и появление третьей роли не должно требовать миграции живой таблицы.
  role    String
  content String

  // Диагностика и учёт расхода: какая модель ответила и сколько токенов
  // потрачено. Нужны, чтобы Основатель видел реальную стоимость помощника.
  model        String?
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Лента чата: WHERE userId=? AND deletedAt IS NULL ORDER BY createdAt.
  // Сортировка по возрастанию (в отличие от остальных лент проекта) —
  // диалог читается сверху вниз.
  @@index([userId, deletedAt, createdAt])
}

// =====================================================================
// ТЗ 6.4 (волна 8): ЕДИНОЕ ОКНО ДИАЛОГОВ ИЗ МЕССЕНДЖЕРОВ.
// =====================================================================

// Провайдер канала. String, а НЕ enum: заказчик подключает каналы поэтапно
// (сейчас Telegram, дальше Chat Place / WhatsApp), и добавление значения не
// должно требовать ALTER TYPE на живой колонке. Единственный источник истины
// по значениям — backend/src/messaging/channels.ts.
model Conversation {
  id String @id @default(uuid())

  // 'TELEGRAM' | 'WHATSAPP' | 'CHATPLACE' | 'INSTAGRAM' | 'OTHER'.
  channel String
  // Идентификатор чата НА СТОРОНЕ ПРОВАЙДЕРА (chat_id у Telegram). Ключ
  // идемпотентности вебхука: повторная доставка не создаёт второй диалог.
  externalId String

  // Как зовут собеседника и его @ник — то, что отдаёт провайдер.
  title    String?
  username String?
  // Телефон, если провайдер его отдал (Telegram отдаёт только при contact-share).
  phone           String?
  // Тот же нормализованный ключ, что у Application/Consultation/Call —
  // по нему единое окно САМО находит карточку клиента.
  phoneNormalized String?

  // Привязка к карточкам. ОБЕ ОПЦИОНАЛЬНЫ и обе могут быть заполнены —
  // тот же паттерн, что Consultation.applicationId? + studentId?.
  // Автопривязка ТОЛЬКО по нормализованному телефону и только когда он
  // однозначен: в Таджикистане один номер регулярно принадлежит семье,
  // поэтому при НЕСКОЛЬКИХ совпадениях связь не ставится вовсе и менеджер
  // выбирает карточку руками (тот же довод, что у Consultation).
  studentId     String?
  student       Student?     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  // Ответственный за диалог. SetNull — как везде в схеме.
  assignedToId String?
  assignedTo   User?   @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Денормализация ради списка диалогов: сортировка по времени последнего
  // сообщения и превью текста без JOIN на таблицу сообщений. Тот же приём,
  // что Payment.stageOrder — иначе список тянул бы последнее сообщение
  // подзапросом на каждую строку.
  lastMessageAt   DateTime  @default(now())
  lastMessageText String?
  // Сколько входящих не прочитано. Считается сервисом: +1 на входящее,
  // 0 при явном «прочитано».
  unreadCount     Int       @default(0)

  messages ChannelMessage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Один диалог = одна строка, повторная доставка вебхука отбивается БД.
  @@unique([channel, externalId])
  // Главный список единого окна: WHERE deletedAt IS NULL ORDER BY lastMessageAt DESC.
  @@index([deletedAt, lastMessageAt(sort: Desc)])
  // Вкладка «Мои диалоги».
  @@index([deletedAt, assignedToId, lastMessageAt(sort: Desc)])
  // Блок «Переписка» в карточке студента/заявки.
  @@index([studentId])
  @@index([applicationId])
  // Автопривязка по номеру.
  @@index([phoneNormalized])
}

// Направление сообщения. enum: набор закрыт физикой (входящее/исходящее),
// таблица новая — CREATE TYPE с нуля безопасен.
enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Одно сообщение диалога. Название ChannelMessage, а не Message: `Message`
// слишком общее слово для схемы, где уже есть Comment, Notification и
// ActivityLog — при чтении кода `prisma.message` было бы неочевидно.
model ChannelMessage {
  id String @id @default(uuid())

  conversationId String
  // Restrict, а не Cascade: переписка — часть истории клиента, она не должна
  // беззвучно исчезать вместе с диалогом (та же семантика, что у Comment).
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  direction MessageDirection
  text      String?

  // Вложения как есть от провайдера (файлы, фото, голосовые): массив
  // { type, url, name }. Json, потому что набор полей у разных провайдеров
  // разный — это АРХИВ, а не конфигурация (тот же принцип, что Payslip.breakdown).
  attachments Json?

  // Идентификатор сообщения у провайдера — ключ идемпотентности вебхука.
  // NULL'ы в Postgres в уникальном индексе между собой не конфликтуют,
  // поэтому исходящие без externalId проходят как есть.
  externalId String?

  // Кто отправил исходящее (у входящих null — писал клиент).
  authorId String?
  author   User?   @relation("ChannelMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  // Момент отправки У ПРОВАЙДЕРА — отдельно от createdAt: вебхук может
  // прийти с задержкой, а лента обязана читаться в порядке реального
  // разговора (та же причина, что у Payment.paidAt и Consultation.heldAt).
  sentAt DateTime @default(now())

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Повторная доставка вебхука отбивается БД.
  @@unique([conversationId, externalId])
  // Лента диалога: WHERE conversationId=? AND deletedAt IS NULL ORDER BY sentAt.
  @@index([conversationId, deletedAt, sentAt])
}
