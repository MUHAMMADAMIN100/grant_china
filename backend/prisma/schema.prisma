generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FOUNDER
  ADMIN
  EMPLOYEE
}

enum Direction {
  BACHELOR
  MASTER
  LANGUAGE
  LANGUAGE_COLLEGE
  LANGUAGE_BACHELOR
  COLLEGE
}

enum ApplicationStatus {
  NEW
  IN_PROGRESS // legacy → DOCS_REVIEW
  COMPLETED // legacy → ENROLLED
  DOCS_REVIEW
  DOCS_SUBMITTED
  PRE_ADMISSION
  AWAITING_PAYMENT
  ENROLLED
}

enum StudentStatus {
  ACTIVE
  PAUSED
  GRADUATED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// Soft delete: вместо физического удаления через `prisma.X.delete()`
// сервисы выставляют `deletedAt = now()`. Все списки/findUnique фильтруют
// `where: { deletedAt: null }`. Даже если атакующий вызовет DELETE-эндпоинт
// или прямой SQL, данные останутся в БД и могут быть восстановлены FOUNDER'ом
// через установку deletedAt обратно в null. Бэкапы (Daily/Weekly/Monthly на
// Railway) — вторая линия обороны.
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  fullName  String
  role      Role      @default(EMPLOYEE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  notifications            Notification[]
  managedApplications      Application[]  @relation("ApplicationManager")
  managedChinaApplications Application[]  @relation("ApplicationChinaManager")
  managedStudents          Student[]      @relation("StudentManager")
  managedChinaStudents     Student[]      @relation("StudentChinaManager")
  assignedTasks            Task[]         @relation("TaskAssignee")
  createdTasks             Task[]         @relation("TaskCreator")

  createdPayments         Payment[]         @relation("PaymentCreatedBy")
  submittedPayments       Payment[]         @relation("PaymentSubmittedBy")
  approvedPayments        Payment[]         @relation("PaymentApprovedBy")
  rejectedPayments        Payment[]         @relation("PaymentRejectedBy")
  voidedPayments          Payment[]         @relation("PaymentVoidedBy")
  updatedPaymentSchedules PaymentSchedule[] @relation("PaymentScheduleUpdatedBy")

  // Раздел 3 ТЗ (заявки/консультации, волна 3).
  archivedApplications Application[]  @relation("ApplicationArchivedBy")
  heldConsultations    Consultation[] @relation("ConsultationManager")
  createdConsultations Consultation[] @relation("ConsultationCreatedBy")

  // Волна 4: реестр грантов, комментарии, звонки.
  createdGrants StudentGrant[] @relation("StudentGrantCreatedBy")
  comments      Comment[]      @relation("CommentAuthor")
  calls         Call[]         @relation("CallUser")

  @@index([deletedAt])
}

// Заявка на обучение: создаётся через лендинг (POST /applications/public),
// либо автоматически вместе со студентом из CRM ("+ Студент").
// При удалении любого из связанных объектов (User-менеджер, Program) заявка
// остаётся в БД с обнулённой ссылкой (SetNull) — историю не теряем.
// При удалении Student — Application НЕ удаляется автоматически
// (нет onDelete: Cascade на student-связи), поэтому в applications.service.remove()
// студент явно удаляется отдельно.
model Application {
  id             String            @id @default(uuid())
  fullName       String
  phone          String
  email          String?
  direction      Direction
  comment        String?
  status         ApplicationStatus @default(NEW)
  studentId      String?
  // student → SetNull-семантика по сути не задана, потому что removed применяется в коде вручную.
  student        Student?          @relation(fields: [studentId], references: [id])
  managerId      String?
  // Удалили сотрудника-менеджера TJ → менеджер у заявки обнуляется, заявка остаётся.
  manager        User?             @relation("ApplicationManager", fields: [managerId], references: [id], onDelete: SetNull)
  chinaManagerId String?
  // Аналогично для китайского менеджера.
  chinaManager   User?             @relation("ApplicationChinaManager", fields: [chinaManagerId], references: [id], onDelete: SetNull)
  programId      String?
  // Удалили программу → у заявки programId становится null.
  program        Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)

  // ── ТЗ 3.1: источник привлечения ───────────────────────────────────
  // String, а НЕ enum. Причина: деплой гоняет `prisma db push --accept-data-loss`.
  // Добавить значение в pg-enum он умеет, но удалить/переименовать/переставить —
  // это DROP TYPE + CREATE TYPE, то есть потеря колонки на живых данных.
  // Волна 7 (Chat Place) принесёт реальные названия каналов из вебхуков, и
  // список ТОЧНО будет меняться. Тот же приём уже применён в проекте к
  // ActivityLog.action и Document.type — новые значения без миграции.
  // Единственный источник истины по значениям — backend/src/common/lead-source.ts,
  // валидация @IsIn(LEAD_SOURCE_VALUES) в DTO на ОБОИХ путях записи.
  // null у 229 исторических заявок = «источник не указан». Бэкфилла НЕТ
  // намеренно: проставить всем WEBSITE — значит выдумать факт и испортить
  // ровно тот отчёт по каналам, ради которого поле и заводится.
  source       String?
  // Уточнение свободным текстом: @ник аккаунта, id рекламной кампании,
  // имя рекомендателя, utm_source «как пришёл». Отдельно от source, чтобы
  // source оставался счётным для GROUP BY. Длина режется в DTO (@MaxLength(200)).
  sourceDetail String?

  // ── ТЗ 3.1: архив ──────────────────────────────────────────────────
  // Признак архивности — nullable timestamp, а не Boolean: тот же приём,
  // что у deletedAt (бесплатно получаем «когда»), плюс на живой таблице это
  // ADD COLUMN NULL без переписывания 229 строк. Архив ПОЛНОСТЬЮ обратим:
  // «Вернуть из архива» ставит archivedAt = null, данные не трогаются.
  archivedAt    DateTime?
  archivedById  String?
  // Уволенного сотрудника soft-удаляют → ссылка обнуляется, факт архивации
  // остаётся (та же семантика, что у manager/chinaManager выше).
  archivedBy    User?     @relation("ApplicationArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  // 'MANUAL: <текст менеджера>' либо 'AUTO: зачислен, 30 дней без изменений'.
  // Свободная строка, а не enum: причин будет больше, чем мы сейчас знаем.
  archiveReason String?

  // ── ТЗ 3.1: «повторное обращение» ──────────────────────────────────
  // Ключ склейки — НОРМАЛИЗОВАННЫЙ телефон. phone хранится так, как ввёл
  // клиент («+992 90 123-45-67», «901234567»), сравнивать сырые строки
  // бесполезно. Денормализованная колонка, а не вычисление на лету: по ней
  // идёт индексный поиск на КАЖДОЕ создание заявки.
  // Заполняется normalizePhone() из common/phone.ts при создании + разовым
  // идемпотентным бэкфиллом на старте (условие `phoneNormalized: null`).
  // ВАЖНО для кода: у заявки, созданной из students.service (phones[0] || ''),
  // телефона может не быть вовсе → здесь остаётся null, и поиск «повторных»
  // обязан ВЫХОДИТЬ РАНЬШЕ, а не искать `phoneNormalized: null` (Prisma
  // превратит это в IS NULL и склеит все безтелефонные заявки в одну кучу).
  phoneNormalized String?
  // Ссылка на ПЕРВУЮ (корневую) заявку с тем же phoneNormalized — не на
  // предыдущую. Тогда все обращения одного человека имеют ОДИН repeatOfId и
  // группируются одним индексным запросом, без рекурсии по цепочке.
  // Это ПОДСКАЗКА, а не склейка личностей: ничего не копируется, студент не
  // привязывается, менеджер сбрасывает флаг в null одной кнопкой.
  repeatOfId      String?
  repeatOf        Application?  @relation("ApplicationRepeat", fields: [repeatOfId], references: [id], onDelete: SetNull)
  repeats         Application[] @relation("ApplicationRepeat")

  // ТЗ 3.2 — таймлайн консультаций в карточке заявки.
  consultations Consultation[]

  // ТЗ 6.3 (волна 4) — лента комментариев и звонков в карточке заявки.
  comments Comment[]
  calls    Call[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([direction])
  @@index([managerId])
  @@index([chinaManagerId])
  @@index([programId])
  @@index([deletedAt])
  // Старый индекс НЕ удаляем: db push сделает реальный DROP INDEX, а он всё
  // ещё обслуживает stats() и любые запросы, которые про архив не знают.
  @@index([deletedAt, createdAt(sort: Desc)])
  // ГЛАВНЫЙ индекс вкладок «Все» / «Новые» / «В работе»:
  // deletedAt IS NULL AND archivedAt IS NULL [AND status=?] ORDER BY createdAt DESC.
  // Обе ведущие колонки зафиксированы условием IS NULL, поэтому порядок по
  // createdAt DESC берётся прямо из индекса — сортировки не будет. Он же
  // обслуживает фильтр по датам (createdAt BETWEEN — range по последней колонке).
  @@index([deletedAt, archivedAt, createdAt(sort: Desc)])
  // Вкладка + фильтр по источнику: «сколько лидов дал Instagram за март».
  // Отдельный индекс, потому что source встаёт МЕЖДУ archivedAt и createdAt,
  // а значит из индекса выше сортировка бы не вышла.
  @@index([deletedAt, archivedAt, source, createdAt(sort: Desc)])
  // «Этот человек уже обращался?» — на каждое создание заявки.
  @@index([phoneNormalized])
  // Цепочка обращений одного человека + вкладка «Ранее зарегистрированные».
  @@index([repeatOfId])
}

model Student {
  id              String        @id @default(uuid())
  fullName        String
  phones          String[]      @default([])
  email           String?
  password        String?
  applicationForm Json?
  photoUrl        String?
  direction       Direction
  cabinet         Int
  status          StudentStatus @default(ACTIVE)
  comment         String?
  managerId       String?
  manager         User?         @relation("StudentManager", fields: [managerId], references: [id], onDelete: SetNull)
  chinaManagerId  String?
  chinaManager    User?         @relation("StudentChinaManager", fields: [chinaManagerId], references: [id], onDelete: SetNull)
  programId       String?
  program         Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  documents       Document[]
  applications    Application[]
  payments        Payment[]
  paymentSchedule PaymentSchedule[]
  // Раздел 3.2 ТЗ — таймлайн консультаций/собеседований в карточке студента.
  consultations   Consultation[]

  // ТЗ 4 (волна 4) — реестр «двойных грантов». Скалярных полей у Student НЕ
  // появляется намеренно: они автоматически уехали бы студенту в
  // /student-auth/me (student-auth.service.ts:129 читает через include).
  grants   StudentGrant[]
  // ТЗ 6.3 (волна 4) — лента комментариев и звонков в карточке студента.
  comments Comment[]
  calls    Call[]

  @@index([direction])
  @@index([cabinet])
  @@index([status])
  @@index([managerId])
  @@index([chinaManagerId])
  @@index([programId])
  @@index([deletedAt])
  // Composite — для главного списка студентов:
  // WHERE deletedAt IS NULL ORDER BY createdAt DESC. Без этого
  // Postgres делает seq scan + sort даже на нашей таблице.
  @@index([deletedAt, createdAt(sort: Desc)])
}

// Документ студента (10 типов + OTHER, + RECEIPT для чеков платежей — см. Payment).
// onDelete: Restrict (Проблема 7 аудита волны 1, п.11 — раньше был Cascade,
// единственная Cascade-связь в схеме). В коде НЕТ ни одного физического
// prisma.student.delete() (только soft-delete через deletedAt, см. правило
// проекта №1), поэтому Cascade здесь никогда не срабатывал на практике —
// но именно поэтому и опасен: любое будущее физическое удаление студента
// (скрипт миграции, консоль Railway, ошибка) беззвучно снесло бы документы,
// включая чеки (Document.paymentId) — часть финансового аудит-следа.
// Restrict превращает такое удаление в ошибку БД вместо тихой потери данных.
model Document {
  id           String    @id @default(uuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  type         String    @default("OTHER")
  // Чек привязан и к студенту (studentId, как все документы — отсюда бесплатная
  // защита /uploads), и к платежу. SetNull, а не Cascade: платёж физически
  // никогда не удаляется, но если это когда-нибудь произойдёт, файл обязан
  // остаться под правами студента, а не исчезнуть.
  paymentId    String?
  payment      Payment?  @relation("PaymentReceipts", fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([studentId, type])
  @@index([deletedAt])
  @@index([paymentId])
}

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String
  status       TaskStatus @default(TODO)
  assignedToId String
  assignedTo   User       @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // ТЗ 3.2 — дата И ВРЕМЯ повторного звонка. Опционально: у существующих
  // и у всех ручных задач срока нет. Хранится в UTC, как все DateTime схемы.
  // Фронт вводит через <input type="datetime-local"> и шлёт new Date(v).toISOString():
  // JS трактует datetime-local как ЛОКАЛЬНОЕ время браузера, а браузер менеджера
  // стоит по Душанбе — «10:00» само превращается в 05:00Z, TZ-математики на
  // сервере для этого пути не нужно вообще.
  dueDate DateTime?

  // КЛЮЧ ИДЕМПОТЕНТНОСТИ автосозданных задач. Формат '<тип>:<id источника>':
  //   'consultation-followup:<consultationId>'  — волна 3
  //   'academic-year:<studentId>:<год>'         — волна 4 (Multi-Grant)
  // @unique — защита живёт в БД, а не в коде: два инстанса Railway, повторный
  // прогон крона и рестарт контейнера ФИЗИЧЕСКИ не могут создать дубль,
  // второй INSERT падает с P2002, сервис его молча глотает.
  // Nullable: у ручных задач ключа нет, а в Postgres NULL'ы в unique-индексе
  // между собой не конфликтуют — существующие строки проходят как есть.
  // Следствие, которое надо знать: если менеджер soft-delete'нул автозадачу,
  // планировщик её НЕ воскресит (ключ занят) — это правильное поведение.
  // Поэтому пересинхронизация (перенос даты звонка) обязана искать задачу по
  // originKey ВКЛЮЧАЯ deletedAt != null и явно решать, воскрешать или нет.
  originKey String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Проблема 11 аудита волны 1: раньше tasks.service.remove() делал
  // prisma.task.delete() — единственное физическое удаление в проекте,
  // прямое нарушение правила №1. Поле опциональное — безопасно для
  // `prisma db push --accept-data-loss` на боевой БД с существующими задачами.
  deletedAt DateTime?

  // Обратная сторона 1:1 связи с консультацией (FK живёт на Consultation).
  consultation Consultation? @relation("ConsultationFollowUpTask")

  @@index([assignedToId])
  @@index([status])
  @@index([deletedAt])
  // «Мои задачи по срокам» + красный бейдж «просрочено» на странице Задачи.
  @@index([assignedToId, status, dueDate])
  // Планировщик и общий список «ближайшие сроки»:
  // WHERE deletedAt IS NULL AND dueDate <= ? ORDER BY dueDate.
  @@index([deletedAt, dueDate])
}

model Program {
  id                String    @id @default(uuid())
  name              String
  university        String
  city              String
  major             String
  direction         Direction
  cost              Float
  currency          String    @default("CNY")
  duration          String?
  language          String?
  description       String?
  imageUrl          String?
  published         Boolean   @default(true)
  telegramMessageId Int?
  telegramHasPhoto  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  applications Application[]
  students     Student[]

  @@index([city])
  @@index([major])
  @@index([direction])
  @@index([published])
  @@index([deletedAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "APPLICATION_NEW", "APPLICATION_DELAY", etc.
  title     String
  message   String
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorName   String
  actorRole   String // ADMIN | EMPLOYEE
  action      String // "STATUS_CHANGE" | "STUDENT_UPDATE" | "MANAGER_CHANGE" | "STUDENT_CREATE" | "STUDENT_DELETE"
  studentId   String?
  studentName String?
  details     String // human-readable: "Статус: NEW → DOCS_REVIEW", "Менеджер TJ: A → B"
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([studentId])
  @@index([actorId])
}

// Сквозная финансовая шкала из ТЗ 1.2. Иерархии «1 / 1.1 / 2 / 2.1» в БД НЕТ:
// по смыслу это 6 самостоятельных платежей в разное время, а не дерево.
// Порядок объявления = порядок в UI, но сортируем по Payment.stageOrder,
// а не по порядку значений enum (переставить значения enum потом = DROP TYPE).
// Подписи для UI (не в БД): INITIAL — «Этап 1. Первичная оплата»,
// REGISTRATION — «Этап 1.1. Регистрация студента», DOCUMENTATION — «Этап 2.
// Документация (виза, приглашение)», ENROLLMENT — «Этап 2.1. После зачисления»,
// RELOCATION — «Этап 3. После переезда в Китай»,
// LIVING_EXPENSES — «Этап 4. Расходы на месте».
enum PaymentStage {
  INITIAL
  REGISTRATION
  DOCUMENTATION
  ENROLLMENT
  RELOCATION
  LIVING_EXPENSES
}

// Этапы 1–3 (SCHEDULE) — разовые платежи агентству по договору: есть плановая
// сумма и срок, попадают в блок «График платежей».
// Этап 4 (ON_SITE) — регулярные расходы студента уже в Китае: плана нет, есть
// только факт, отдельный блок «Расходы на месте».
// Поле денормализовано (выводится из stage), потому что по нему UI и отчёты
// делят выборку, и без него каждый запрос тащил бы NOT IN (...) по stage.
enum PaymentKind {
  SCHEDULE
  ON_SITE
}

// payment_purpose из ТЗ 1.3, ровно 8 значений:
// Регистрация студента / Документация / Зачисление в университет /
// После переезда / Проживание / Питание / Консультация / Другое.
enum PaymentPurpose {
  REGISTRATION
  DOCUMENTATION
  ENROLLMENT
  RELOCATION
  ACCOMMODATION
  FOOD
  CONSULTATION
  OTHER
}

// payment_method из ТЗ 1.3: Наличные / Безналичный расчёт.
// Имя CASHLESS (а не BANK) намеренно — 'BANK' уже занят как Document.type
// (справка из банка), одинаковые строки в разных справочниках путают.
enum PaymentMethod {
  CASH
  CASHLESS
}

// Double Check (ТЗ 1.1): деньги считаются полученными ТОЛЬКО в APPROVED.
// DRAFT — черновик, PENDING_APPROVAL — «Ожидает одобрения Основателем»,
// REJECTED — отклонён (правится и подаётся заново той же записью),
// VOID — аннулирован после одобрения (правило проекта: не удаляем, а сторнируем).
enum PaymentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  VOID
}

// ФАКТ оплаты. Одна строка = одно фактическое поступление денег.
// Частичные оплаты одного этапа — это несколько строк с одним stage, поэтому
// плановая сумма живёт НЕ здесь, а в PaymentSchedule (иначе план дублировался
// бы в каждой частичной оплате и разъезжался).
model Payment {
  id String @id @default(uuid())

  studentId String
  // onDelete: Restrict, а не Cascade (Проблема 7 аудита волны 1): studentId
  // обязателен (не nullable), поэтому SetNull невозможен. Финансовая история
  // (факты оплат, чеки через Document.paymentId) не должна беззвучно
  // исчезать, если студент когда-нибудь будет физически удалён — Restrict
  // заставит такую операцию упасть с ошибкой БД, а не молча снести бухгалтерию.
  // Сейчас студент удаляется только soft (deletedAt), поэтому ограничение
  // ничего не ломает при обычной работе.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Волна 6 (Contract) добавит сюда relation. Сейчас — «голый» nullable-скаляр:
  // так волна 6 навесит связь одним ALTER TABLE ADD CONSTRAINT, без миграции данных.
  contractId String?

  stage      PaymentStage
  // Денормализация ради сортировки/группировки в отчётах: ORDER BY stageOrder
  // не зависит от порядка объявления значений enum в Postgres (менять его
  // потом = пересоздание типа). Заполняется сервисом из константы STAGE_ORDER.
  stageOrder Int            @default(0)
  kind       PaymentKind    @default(SCHEDULE)
  purpose    PaymentPurpose
  method     PaymentMethod

  // Деньги — только Decimal. Float даёт 0.1+0.2=0.30000000000000004 и
  // расхождение в сводке «оплачено/осталось». 12,2 = до 9 999 999 999.99 TJS.
  amount   Decimal @db.Decimal(12, 2)
  // Валюта проекта одна (сомони). Поле оставлено, чтобы не переделывать схему,
  // если когда-нибудь появится вторая; UI селектор валюты НЕ показывает.
  currency String  @default("TJS")

  // Фактическая дата поступления денег (её вводит менеджер, может отличаться
  // от createdAt). Все отчёты «за период» строятся по paidAt, а не по createdAt.
  paidAt  DateTime  @default(now())
  // Снимок планового срока этапа на момент внесения платежа (копируется из
  // PaymentSchedule.dueDate). Нужен для KPI «своевременность сбора оплат» из раздела 5:
  // если потом отредактировать план, историческая метрика не должна «переехать».
  dueDate DateTime?

  // Номер квитанции/банковской транзакции — Основателю нужно чем-то сверять
  // безнал с выпиской, глазами по фото чека это не делается.
  reference String?
  comment   String?

  status PaymentStatus @default(DRAFT)

  // Кто внёс данные. SetNull — уволенного сотрудника soft-удаляют, платёж
  // должен остаться (та же семантика, что у Application.manager).
  createdById String?
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Кто нажал «Подтвердить». Ключевое поле Double Check: одобрить платёж
  // может только пользователь, чей id НЕ равен submittedById.
  submittedById String?
  submittedBy   User?     @relation("PaymentSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?

  // Финальное акцептование Основателя. approvedAt НИКОГДА не обнуляется,
  // даже при последующем VOID — иначе теряется дата проведения для аудита.
  approvedById String?
  approvedBy   User?     @relation("PaymentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  // Последнее отклонение. Полная история отклонений — в ActivityLog
  // (action = 'PAYMENT_REJECT'), здесь только «что показать менеджеру сейчас».
  rejectedById    String?
  rejectedBy      User?     @relation("PaymentRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?
  rejectionReason String?

  // Аннулирование уже проведённого платежа (ошибка ввода). Правило проекта —
  // никогда не удалять: APPROVED нельзя ни удалить, ни отредактировать, только
  // перевести в VOID с причиной, и он перестаёт учитываться в суммах.
  voidedById String?
  voidedBy   User?     @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidedAt   DateTime?
  voidReason String?

  // Чеки — обычные Document (type='RECEIPT'), поэтому автоматически получают
  // защиту /uploads через files/file-resolver.service.ts (ветка DOCUMENT).
  receipts Document[] @relation("PaymentReceipts")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  // Отдельный @@index([deletedAt]) не нужен: он префикс двух composite-индексов
  // выше, Postgres использует их — лишний индекс только замедлял бы запись.

  // Карточка студента: WHERE studentId=? AND deletedAt IS NULL ORDER BY stageOrder.
  @@index([studentId, deletedAt, stageOrder])
  // Очередь Основателя: WHERE status='PENDING_APPROVAL' AND deletedAt IS NULL
  // ORDER BY submittedAt (сначала те, кто ждёт дольше всех).
  @@index([status, deletedAt, submittedAt])
  // Отчёт «проведено за период»: status='APPROVED' + paidAt BETWEEN, сортировка по дате.
  @@index([status, deletedAt, paidAt(sort: Desc)])
  // Общий список страницы «Финансы» без фильтра по статусу.
  @@index([deletedAt, paidAt(sort: Desc)])
  // Просрочки/ближайшие сроки (KPI раздела 5).
  @@index([deletedAt, dueDate])
  // «Кто сколько внёс» — срез по сотруднику.
  @@index([createdById])
  // Волна 6: платежи по договору.
  @@index([contractId])
}

// ПЛАН по этапу: индивидуальные суммы и сроки договора. Отдельная сущность,
// потому что план существует ДО первого факта (график виден сразу после
// подписания договора) и потому что один этап может быть оплачен частями —
// хранить план на строке факта означало бы дублировать и рассинхронизировать его.
// Волна 6 перевесит владение планом на Contract через тот же contractId.
// Этап 4 (LIVING_EXPENSES) строки здесь НЕ имеет: у расходов на месте плана нет.
model PaymentSchedule {
  id String @id @default(uuid())

  studentId String
  // onDelete: Restrict — та же причина, что у Payment.student выше: план
  // оплат не должен беззвучно исчезнуть при гипотетическом физическом
  // удалении студента.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  contractId String?

  stage      PaymentStage
  stageOrder Int          @default(0)

  // 0 = «сумма ещё не согласована»; строка создаётся сразу для всех этапов
  // графика, чтобы UI показывал полную шкалу с самого начала.
  plannedAmount Decimal   @default(0) @db.Decimal(12, 2)
  currency      String    @default("TJS")
  dueDate       DateTime?

  comment String?

  // Кто последний менял плановую сумму/срок — финансовый контроль.
  updatedById String?
  updatedBy   User?   @relation("PaymentScheduleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Один этап у студента = одна плановая строка. Конфликта с soft-delete нет:
  // строки графика не удаляются (обнуляется plannedAmount), а сервис работает
  // через upsert по [studentId, stage] — он же «воскрешает» deletedAt в null.
  @@unique([studentId, stage])
  @@index([studentId, deletedAt, stageOrder])
  @@index([deletedAt, dueDate])
  @@index([contractId])
}

// =====================================================================
// Раздел 3 ТЗ (волна 3): база консультаций/собеседований + планировщик.
// =====================================================================

// ТЗ 3.2 различает «очную консультацию» и «собеседование»: разные события,
// разная длительность, разный смысл в отчётности.
// Здесь enum, а НЕ String (в отличие от Application.source): набор закрыт
// самим ТЗ и меняться не будет, а таблица НОВАЯ — создание типа с нуля не
// трогает ни одной живой строки, значит риск `db push` нулевой.
enum ConsultationKind {
  CONSULTATION
  INTERVIEW
}

// «Решение клиента», которое менеджер фиксирует ПОСЛЕ повторного звонка —
// ради этого ТЗ 3.2 и требует автозадачу («для уточнения решения клиента»).
// null = решение ещё не зафиксировано, звонок не состоялся.
enum ConsultationOutcome {
  THINKING // думает, нужен ещё один контакт
  AGREED // согласен, оформляем заявку
  REFUSED // отказ
  UNREACHABLE // не дозвонились
}

// ТЗ 3.2 — «База данных консультаций и собеседований».
// ОТДЕЛЬНАЯ модель, а не статус у Application. Три причины:
//  1) Application — позиция в ВОРОНКЕ (NEW→…→ENROLLED). На каждую смену
//     статуса applications.service шлёт клиенту SMS и считает STAGE_ORDER;
//     фиктивный статус CONSULTATION сломал бы и рассылку, и аналитику.
//  2) Консультация — СОБЫТИЕ, их у одного человека несколько: до заявки,
//     между этапами и после зачисления. «Одна консультация = одна заявка»
//     раздула бы список заявок и все существующие счётчики.
//  3) У Application поле `direction` ОБЯЗАТЕЛЬНОЕ, а пришедший в офис человек
//     направление ещё не выбрал. Пришлось бы либо писать фиктивное значение,
//     либо ослаблять обязательное поле на 229 живых строках.
model Consultation {
  id String @id @default(uuid())

  // Три поля, которые ТЗ 3.2 требует фиксировать явно.
  fullName String
  phone    String
  purpose  String // «цель обращения» — свободный текст, менеджер пишет как сказал клиент

  // Тот же нормализованный ключ, что у Application.phoneNormalized. По нему
  // собирается история обращений человека, у которого ещё нет ни заявки,
  // ни карточки студента. Только для ЧТЕНИЯ истории — автосклейки по нему нет.
  phoneNormalized String?

  kind         ConsultationKind     @default(CONSULTATION)
  outcome      ConsultationOutcome?
  // Источник привлечения — тот же справочник, что у заявки (common/lead-source.ts).
  source       String?
  sourceDetail String?
  // Направление, если человек уже определился. Опционально — на консультации
  // его часто ещё нет; при конвертации в заявку переносится как есть.
  direction    Direction?
  comment      String?

  // Когда консультация ФАКТИЧЕСКИ проведена. Отдельно от createdAt: менеджер
  // вносит вчерашнюю встречу сегодня, а отчёт «сколько консультаций за неделю»
  // обязан считаться по факту, а не по моменту ввода в CRM. Та же причина,
  // по которой у Payment есть paidAt отдельно от createdAt.
  heldAt DateTime @default(now())

  // Ответственный менеджер — ЕМУ уходит автозадача на повторный звонок.
  managerId   String?
  manager     User?   @relation("ConsultationManager", fields: [managerId], references: [id], onDelete: SetNull)
  // Кто внёс запись: администратор может зафиксировать встречу за менеджера.
  // Тот же раздельный учёт «исполнитель/автор», что у Payment.createdBy/submittedBy.
  createdById String?
  createdBy   User?   @relation("ConsultationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Обе связи ОПЦИОНАЛЬНЫ и обе могут быть заполнены одновременно.
  // Человек «с улицы» не имеет ни заявки, ни студента — это нормальное
  // состояние данных, а не дефект. Связь ставится ТОЛЬКО явным действием
  // («Создать заявку из консультации») либо переносится там, где она уже
  // доказана (заявка получила studentId → её консультации получают тот же).
  // По совпадению телефона связь не проставляется НИКОГДА: в Таджикистане
  // один номер регулярно принадлежит семье, автосклейка объединила бы брата
  // с сестрой и увела бы чужую карточку не тому менеджеру.
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  studentId     String?
  student       Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Волна 7: фактические звонки по этой консультации (замыкает петлю ТЗ 3.2
  // «повторный звонок назначен» → «звонок сделан»). В волне 4 записей нет.
  calls Call[]

  // ТЗ 3.2 — дата и время ПОВТОРНОГО ЗВОНКА.
  followUpAt     DateTime?
  // Автозадача, созданная СИНХРОННО при сохранении консультации. Связь 1:1,
  // поэтому FK помечен @unique. FK живёт здесь, а не на Task: Task — общая
  // таблица всего проекта, навешивать на неё по FK под каждую будущую
  // сущность-источник нельзя, у неё один универсальный ключ — originKey.
  followUpTaskId String?   @unique
  followUpTask   Task?     @relation("ConsultationFollowUpTask", fields: [followUpTaskId], references: [id], onDelete: SetNull)
  // Флаг идемпотентности для планировщика: напоминание «сегодня звонок»
  // уходит РОВНО ОДИН РАЗ. Джоба сначала атомарно занимает строку
  // (updateMany where { id, reminderSentAt: null } → count === 1 значит «моё»),
  // и только потом шлёт уведомление. Два инстанса не отправят его дважды.
  reminderSentAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Главный список раздела: WHERE deletedAt IS NULL ORDER BY heldAt DESC
  // (+ фильтр по датам heldAt BETWEEN — range по последней колонке).
  @@index([deletedAt, heldAt(sort: Desc)])
  // Вкладка «Мои» и фильтр по ответственному менеджеру (ТЗ 3.1, тот же набор).
  @@index([deletedAt, managerId, heldAt(sort: Desc)])
  // История обращений по номеру — блок в карточке заявки/студента.
  @@index([phoneNormalized, heldAt(sort: Desc)])
  // Таймлайн консультаций внутри карточки заявки/студента.
  @@index([applicationId])
  @@index([studentId])
  // Планировщик, джоба напоминаний:
  // WHERE deletedAt IS NULL AND reminderSentAt IS NULL AND followUpAt <= ?
  @@index([deletedAt, reminderSentAt, followUpAt])
}

// Состояние планировщика (@nestjs/schedule). Одна строка на джобу, 3–5 строк
// всего. Таблица нужна НЕ для корректности — идемпотентность обеспечена на
// уровне данных (Task.originKey @unique, Consultation.reminderSentAt,
// updateMany с условием) — а для двух вещей:
//  1) ЗАХВАТ РАБОТЫ между несколькими инстансами Railway БЕЗ Redis. Атомарный
//     compare-and-swap одним запросом:
//       updateMany({ where: { job, OR: [{ running: false },
//                                       { lockedAt: { lt: staleCutoff } }] },
//                    data:  { running: true, lockedAt: now, lockedBy: instanceId } })
//     Под READ COMMITTED второй инстанс блокируется на той же строке,
//     после коммита первого перечитывает её, не проходит по WHERE и получает
//     count = 0 → тихо выходит. Никаких advisory-локов и raw SQL.
//  2) НАБЛЮДАЕМОСТЬ: Основатель видит на GET /scheduler/status, что планировщик
//     жив, когда был последний успешный прогон и какая была последняя ошибка.
// lockedAt + порог протухания решают падение контейнера посреди прогона:
// running останется true, но через STALE_LOCK_MS работу можно перезахватить.
// deletedAt тут нет намеренно: это операционное состояние процесса, а не
// бизнес-данные; строки только upsert'ятся и никогда не удаляются.
model SchedulerRun {
  id String @id @default(uuid())

  // ScheduledJob.name — стабильный идентификатор джобы в коде.
  job String @unique

  running  Boolean   @default(false)
  lockedAt DateTime?
  // Кто держит работу: RAILWAY_REPLICA_ID либо hostname+pid. Нужен, чтобы в
  // логах было видно, какой инстанс подвис.
  lockedBy String?

  lastRunAt DateTime?
  lastOkAt  DateTime?
  lastError String?

  // Счётчики последнего прогона — отдаются в /scheduler/status.
  lastCreated Int @default(0)
  lastSkipped Int @default(0)
  runs        Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Индексов кроме @unique(job) нет НАМЕРЕННО: в таблице 3–5 строк, любой
  // дополнительный индекс здесь только замедлил бы запись при каждом тике.
}

// =====================================================================
// Раздел 4 ТЗ (волна 4): реестр студентов с «двойным грантом» (Multi-Grant).
// =====================================================================

// Набор, с которого стартует учебный год. В Китае это сентябрь, но февральский
// набор существует и у нас есть такие студенты. Поле ВЫЧИСЛЯЕТСЯ СЕРВИСОМ из
// startDate при каждой записи startDate и руками не редактируется — поэтому
// разъехаться с датой не может.
// Зачем вообще хранить производное значение: Prisma не умеет фильтровать по
// EXTRACT(MONTH FROM ...) без $queryRaw, а raw SQL в проекте нет ни одного.
// Тот же приём уже применён в проекте к Payment.stageOrder.
// enum, а не String (в отличие от Application.source): набор закрыт реальностью
// (два набора в году + «прочее»), а таблица НОВАЯ — CREATE TYPE с нуля не
// трогает ни одной живой строки, риск db push нулевой.
enum GrantIntake {
  SEPTEMBER
  FEBRUARY
  OTHER
}

// Состояние гранта, а НЕ состояние студента (Student.status — про человека:
// ACTIVE/PAUSED/GRADUATED/ARCHIVED). Разделены намеренно: студент может быть
// ACTIVE, а грант уже TERMINATED (лишили за неуспеваемость) — и наоборот,
// студент в PAUSED (академ), а грант жив и в сентябре продолжится.
// Джоба напоминаний работает ТОЛЬКО со status = ACTIVE.
enum GrantStatus {
  ACTIVE // действует, годы впереди ещё есть
  SUSPENDED // приостановлен (академотпуск, спор с вузом) — напоминания молчат
  COMPLETED // отучился все totalYears
  TERMINATED // прекращён досрочно (отчисление, отказ, лишение)
}

// ТЗ 4 — «отдельная категория базы данных» для студентов с грантом,
// пролонгированным на 2-й и последующие годы.
//
// ОТДЕЛЬНАЯ ТАБЛИЦА, а не поля в Student:
//  1) у одного человека грантов бывает НЕСКОЛЬКО и подряд (языковой год по
//     одному гранту, затем бакалавриат по другому) — это и есть «двойной
//     грант» в лексике агентства, плоские поля вместили бы ровно один;
//  2) УТЕЧКА В ЛИЧНЫЙ КАБИНЕТ: student-auth.service.ts читает студента через
//     `include: STUDENT_INCLUDE`, а include тянет ВСЕ скаляры модели — любое
//     новое скалярное поле Student автоматически уехало бы студенту в
//     /student-auth/me. Поля отдельной таблицы через include не подтягиваются
//     никогда, пока их явно не попросят;
//  3) реестр — отдельный экран со своими фильтрами/сортировкой, вешать
//     индексы под него на Student (главный список CRM) — лишняя плата записью;
//  4) джоба планировщика сканирует маленькую таблицу реестра, а не всех студентов.
//
// ПРИЗНАК «ДВОЙНОГО ГРАНТА» — ВЫЧИСЛЯЕМЫЙ: totalYears > 1. Отдельного булева
// флага НЕТ намеренно: флаг и число — два источника истины про один факт и
// разъедутся в первый же месяц. Число нужно автоматизации в любом случае —
// оно знает, КОГДА ПЕРЕСТАТЬ напоминать.
model StudentGrant {
  id String @id @default(uuid())

  studentId String
  // onDelete: Restrict — та же семантика, что у Document/Payment/PaymentSchedule.
  // Физического удаления студента в проекте нет, но если оно когда-нибудь
  // появится, реестр грантов должен уронить операцию ошибкой БД, а не
  // беззвучно исчезнуть.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Название/тип гранта как его называет вуз: «CSC Type A», «Стипендия
  // провинции Хэнань», «Грант университета». Свободный текст, а не справочник.
  name       String?
  // Вуз, ВЫДАВШИЙ грант. Снимок, а не ссылка на Program: программа у студента
  // может смениться, а факт «грант дал этот вуз» — исторический.
  university String?

  // Сколько лет обучения покрывает грант. 1 = разовый (в реестр «двойных» не
  // попадает и напоминаний не порождает).
  totalYears  Int @default(1)
  // Какой год обучения идёт СЕЙЧАС, 1-based. Двигается ТОЛЬКО явным действием
  // человека (POST /grants/:id/advance), а не автоматически по календарю:
  // грант могли не продлить (не сдал сессию, лишили), и CRM не имеет права
  // записать факт, которого не было.
  currentYear Int @default(1)

  // Старт ПЕРВОГО учебного года по гранту. Иммутабелен по смыслу (правится
  // только как исправление ошибки ввода). Семантика — КАЛЕНДАРНАЯ ДАТА:
  // сервис приводит её к 00:00 по Душанбе (APP_TZ_OFFSET_MINUTES из
  // scheduler/time.ts).
  startDate DateTime
  // Производное от месяца startDate, считает сервис (см. комментарий к enum).
  intake    GrantIntake @default(SEPTEMBER)

  // ГЛАВНОЕ ПОЛЕ АВТОМАТИЗАЦИИ: плановая дата старта СЛЕДУЮЩЕГО учебного
  // года. Денормализация вынужденная: Prisma не умеет ни арифметику дат в
  // WHERE, ни сравнение двух колонок между собой без $queryRaw (которого в
  // проекте нет вовсе). Обычная индексируемая колонка превращает выборку
  // джобы в один range-скан.
  //
  // ИНВАРИАНТ (держит сервис на КАЖДОЙ записи):
  //   nextYearStartsAt IS NOT NULL  ⟺  status = ACTIVE И currentYear < totalYears.
  // При переводе на следующий год новое значение считается ЦЕПОЧКОЙ:
  // next_new = next_old + 1 год (а не «startDate + N лет») — если вуз сдвинул
  // старт второго года на две недели, сдвиг обязан унаследоваться третьим годом.
  nextYearStartsAt DateTime?

  // Флаг идемпотентности планировщика — тот же приём, что Consultation.reminderSentAt:
  // джоба сначала атомарно ЗАНИМАет строку (updateMany where { id, reminderSentAt: null }
  // → count === 1 значит «моя»), и только потом создаёт задачу. Сбрасывается
  // сервисом в null при каждом изменении nextYearStartsAt и при переводе на
  // следующий год — новый срок = новый цикл напоминания.
  // ВТОРОЙ, независимый слой защиты от дублей — Task.originKey @unique.
  reminderSentAt DateTime?

  status GrantStatus @default(ACTIVE)
  // Условия продления (нужный GPA, требования вуза), договорённости.
  note   String?

  // Кто завёл грант в реестр. SetNull — уволенного сотрудника soft-удаляют,
  // запись остаётся. Используется ещё и как ФОЛБЭК-исполнитель автозадачи,
  // если у студента нет менеджера.
  createdById String?
  createdBy   User?   @relation("StudentGrantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Блок «Грант» в карточке студента.
  @@index([studentId])
  // ОДИН индекс на два сценария:
  //  а) джоба: deletedAt IS NULL AND status='ACTIVE' AND nextYearStartsAt BETWEEN ?;
  //  б) реестр: та же голова + ORDER BY nextYearStartsAt.
  @@index([deletedAt, status, nextYearStartsAt])
}

// =====================================================================
// Раздел 6.3 ТЗ (волна 4): комментарии как СОБЫТИЯ ленты активности.
// =====================================================================

// По умолчанию комментарий ВНУТРЕННИЙ — это заметка менеджера, а не сообщение
// студенту. В волне 4 API значение не принимает и не отдаёт — DTO его не
// содержит, эндпоинтов комментариев в личном кабинете нет вовсе.
enum CommentVisibility {
  INTERNAL
  STUDENT_VISIBLE
}

// ТЗ 6.3 — «добавление текстовых комментариев» как события ленты.
//
// Почему НЕ расширение Student.comment/Application.comment: там ОДНА строка
// без автора и без времени, второй комментарий затирает первый. Лента
// требует истории — значит нужна строка на комментарий.
// Существующие поля НЕ ТРОГАЕМ и НЕ ПЕРЕНОСИМ: в Application.comment лежит
// сообщение клиента с лендинга, в Student.comment — заметка менеджера. В UI
// старое поле остаётся отдельным блоком НАД лентой.
//
// СВЯЗЬ — ДВЕ NULLABLE-ССЫЛКИ, А НЕ ПОЛИМОРФИЗМ (entityType+entityId): тот же
// паттерн, что уже есть и работает — Consultation.applicationId? + studentId?.
// ИНВАРИАНТ (держит сервис, CHECK в Prisma не выражается): заполнена хотя бы
// одна из ссылок.
model Comment {
  id String @id @default(uuid())

  // Текст. Длина режется в DTO (@MaxLength(4000)) — в ActivityLog.details
  // уезжает только превью ~200 символов.
  body String

  studentId String?
  // Restrict, а не SetNull: комментарий — часть аудит-следа. Комментарий,
  // потерявший якорь, не виден ни в одной ленте — тихая потеря данных.
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  // Автор. Nullable + SetNull для единообразия со всей схемой (Payment.createdBy).
  authorId String?
  author   User?   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  visibility CommentVisibility @default(INTERNAL)

  // Отметка «отредактирован» — лента обязана честно показывать, что текст
  // меняли после публикации. Сам исходный текст остаётся в ActivityLog.
  editedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Лента в карточке студента: WHERE studentId=? AND deletedAt IS NULL
  // ORDER BY createdAt DESC — сортировка из индекса.
  @@index([studentId, deletedAt, createdAt(sort: Desc)])
  // То же в карточке заявки.
  @@index([applicationId, deletedAt, createdAt(sort: Desc)])
  // «Что писал этот сотрудник» — срез для Основателя.
  @@index([authorId, createdAt(sort: Desc)])
}

// =====================================================================
// Раздел 6.3 ТЗ — ЗАГОТОВКА ПОД IP-ТЕЛЕФОНИЮ (волна 7).
// В ЭТОЙ ВОЛНЕ ЗАПИСЕЙ НЕ СОЗДАЁТСЯ НИ ОДНОЙ: эндпоинтов записи нет, сидов
// нет, фикстур нет. Таблица заводится сейчас, чтобы волна 7 добавила ТОЛЬКО
// адаптер провайдера и вебхук, не трогая схему на живой базе.
// =====================================================================

// INTERNAL (звонок между сотрудниками) сознательно НЕ заводим: он не нужен
// ни одному отчёту ТЗ. Добавление значения в pg-enum — безопасная операция
// для db push, поэтому расширить набор волна 7 сможет без миграции данных.
enum CallDirection {
  INBOUND
  OUTBOUND
}

// Надмножество исходов, которые отдают IP-АТС. Провайдер ещё не выбран,
// поэтому набор сознательно шире, чем нужно сегодня — всё, что не свелось,
// переживает в Call.raw без потери информации.
enum CallStatus {
  COMPLETED // разговор состоялся
  NO_ANSWER // не ответили
  BUSY // занято
  FAILED // техническая ошибка/недоступен
  CANCELED // отменён до соединения
  VOICEMAIL // ушёл на автоответчик
}

model Call {
  id String @id @default(uuid())

  // Имя провайдера. String, а не enum: провайдер НЕ ВЫБРАН. 'MANUAL' —
  // звонок, зафиксированный менеджером руками (если такой эндпоинт появится
  // — НЕ в этой волне).
  provider   String  @default("MANUAL")
  // Идентификатор звонка НА СТОРОНЕ ПРОВАЙДЕРА. Ключ идемпотентности вебхука.
  // Составной @@unique с provider — NULL'ы в Postgres в уникальном индексе
  // между собой не конфликтуют, ручные звонки без externalId проходят как есть.
  externalId String?

  direction CallDirection
  status    CallStatus    @default(COMPLETED)

  // Номер СОБЕСЕДНИКА (клиента) в том виде, как его отдал провайдер.
  phone           String
  // Тот же ключ склейки, что у Application.phoneNormalized/Consultation.phoneNormalized.
  line            String? // номер/линия агентства, на которую пришёл или с которой ушёл звонок
  phoneNormalized String?

  // Три момента: длительность СОЕДИНЕНИЯ и длительность ОЖИДАНИЯ — разные
  // метрики (KPI раздела 5 считается именно по answeredAt − startedAt).
  startedAt   DateTime
  answeredAt  DateTime?
  endedAt     DateTime?
  // Длительность РАЗГОВОРА в секундах, денормализована — любая АТС отдаёт
  // её готовой.
  durationSec Int       @default(0)

  // Ссылка на запись У ПРОВАЙДЕРА. В /uploads в этой волне ничего не
  // скачивается — хранение записей разговоров решает Основатель отдельно.
  recordingUrl String?

  // Сотрудник на внутренней линии. SetNull — как везде в схеме.
  userId String?
  user   User?   @relation("CallUser", fields: [userId], references: [id], onDelete: SetNull)

  // Три опциональные привязки, как у Comment/Consultation. Звонок с
  // неизвестного номера не привязан ни к кому — нормальное состояние данных.
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  // Замыкает петлю ТЗ 3.2: «повторный звонок назначен» → «звонок сделан».
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  // Итог разговора словами менеджера (не транскрипция).
  comment String?
  // СЫРОЙ payload вебхука. Провайдер не выбран — поля неизвестны заранее.
  // ВНИМАНИЕ ДЛЯ ВОЛНЫ 7: raw содержит PII и НЕ ОТДАЁТСЯ наружу — ни
  // студенту, ни EMPLOYEE; только FOUNDER и только явным запросом.
  raw     Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Один звонок = одна строка, повторная доставка вебхука отбивается БД.
  @@unique([provider, externalId])
  // Блок «Звонки» в карточке студента.
  @@index([studentId, deletedAt, startedAt(sort: Desc)])
  // То же в карточке заявки.
  @@index([applicationId, startedAt(sort: Desc)])
  // «Сколько звонков сделал сотрудник за период» — KPI раздела 5.
  @@index([userId, startedAt(sort: Desc)])
  // Сшивка с историей обращений по номеру.
  @@index([phoneNormalized])
  // Общий журнал звонков за период.
  @@index([deletedAt, startedAt(sort: Desc)])
}
