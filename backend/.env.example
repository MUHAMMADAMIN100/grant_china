# =============================================================================
# GrantChina CRM — переменные окружения бэкенда.
#
# Обязательны только DATABASE_URL и JWT_SECRET — без них приложение не
# стартует. Всё остальное опционально: незаданная интеграция просто
# отключается, а зависящий от неё раздел UI либо прячется, либо честно
# пишет, что интеграция не настроена.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URL="postgresql://grantchina:grantchina@localhost:5432/grantchina?schema=public"

# --- Сервер ------------------------------------------------------------------
PORT=3001

# --- JWT сотрудников CRM -----------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Отдельный JWT для студентов (личный кабинет). Если не задан — используется
# JWT_SECRET (legacy fallback). Рекомендуется задать свою длинную строку:
# компрометация токена студента не должна открывать доступ к CRM.
STUDENT_JWT_SECRET=""

# --- CORS и cookie -----------------------------------------------------------
# Список фронтендов через запятую. На проде запросы идут через Vercel rewrite
# сервер-к-серверу и заголовка Origin вообще не содержат — в этом случае
# проверка CORS намеренно пропускает запрос (см. main.ts).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Принудительный SameSite для cookie сессии: "lax" | "strict" | "none".
# Пусто — режим выбирается автоматически (см. auth/cookie-helpers.ts).
# "none" требует HTTPS и нужен, только если CRM и API живут на разных доменах.
COOKIE_SAMESITE=""

# --- Файлы -------------------------------------------------------------------
UPLOADS_DIR="./uploads"
MAX_FILE_SIZE=209715200

# Защита раздачи /uploads авторизацией. По умолчанию ВКЛЮЧЕНА.
# UPLOADS_PROTECTED=0 — аварийный откат на публичную раздачу; включать только
# осознанно: в /uploads лежат паспорта, справки, чеки и билеты.
UPLOADS_PROTECTED="1"

# --- Telegram: служебный бот CRM ---------------------------------------------
# Бот @grant_chinabot — уведомления сотрудникам и автопостинг программ.
# Токен получить у @BotFather.
TELEGRAM_BOT_TOKEN=""

# Личный чат или группа администраторов — туда бот шлёт уведомления о новых
# заявках с лендинга. ID можно узнать у @userinfobot.
TELEGRAM_CHAT_ID=""

# Публичный канал (например "@grant_china_tj" или числовой ID -100xxxx), куда
# бот постит карточки программ. Бот должен быть админом канала.
TELEGRAM_CHANNEL_ID=""

# --- Telegram: клиентский бот (ТЗ 6.4 — единое окно диалогов) ----------------
# ОТДЕЛЬНЫЙ бот, с которым переписываются клиенты. Намеренно не тот же, что
# служебный: у них разные аудитории, и клиент не должен видеть служебные
# уведомления компании.
TELEGRAM_CLIENT_BOT_TOKEN=""

# Секрет вебхука клиентского бота. Передаётся в setWebhook и сверяется с
# заголовком X-Telegram-Bot-Api-Secret-Token на каждом входящем апдейте.
# Задайте длинную случайную строку — без неё вебхук не регистрируется.
TELEGRAM_CLIENT_WEBHOOK_SECRET=""

# --- Внешний адрес бэкенда ---------------------------------------------------
# Нужен Telegram, чтобы подгрузить картинку программы, и для регистрации
# вебхука клиентского бота. Пример: https://grantchina-production.up.railway.app
PUBLIC_API_BASE=""

# Куда ведёт ссылка «войти в личный кабинет» в письме студенту.
STUDENT_LOGIN_URL=""

# --- Email через Brevo (доступы студенту, служебные уведомления) -------------
# HTTP API Brevo, а не SMTP: Railway блокирует исходящий 25/587, и SMTP там
# просто не работает. Ключ: app.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=""
MAIL_FROM_EMAIL="noreply@grantchina.tj"
MAIL_FROM_NAME="GrantChina"

# Почта, на которую приходят служебные уведомления (например заявка с сайта).
ADMIN_EMAIL=""

# --- SMS ---------------------------------------------------------------------
# SMS_PROVIDER = "payom" | "smsru" | "twilio" | пусто (отключено).
# Используется для выдачи доступов студенту и напоминания о вылете (ТЗ «Билеты»).
SMS_PROVIDER=""

# Payom.tj — таджикский шлюз. https://payom.tj/ → API → Bearer token.
# PAYOM_SENDER — имя отправителя, максимум 11 символов латиницей.
PAYOM_API_URL="https://gateway.payom.tj"
PAYOM_TOKEN=""
PAYOM_SENDER=""

# SMS.ru — RU/CIS. https://sms.ru → Settings → API → API ID
SMSRU_API_ID=""
SMS_FROM=""

# Twilio — глобальный. https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- AI-помощник (ТЗ 6.1) ----------------------------------------------------
# Ключ Anthropic: console.anthropic.com → API Keys.
# Пока ключ не задан, виджет помощника в CRM не показывается вовсе — раздел
# «База знаний» при этом работает как обычный справочник регламентов.
ANTHROPIC_API_KEY=""

# Модель. По умолчанию claude-opus-5. Менять только осознанно.
AI_MODEL=""

# --- IP-телефония (ТЗ 6.2) ---------------------------------------------------
# Общий секрет вебхука АТС, приходит в заголовке x-webhook-secret.
# ВАЖНО: пока переменная не задана, эндпоинт /calls/webhook/:provider отвечает
# 401 на любой запрос. Это осознанно — принимать анонимные записи в журнал
# звонков нельзя. Ручная фиксация звонков и click-to-call работают и без неё.
TELEPHONY_WEBHOOK_SECRET=""

# --- Планировщик (@nestjs/schedule) ------------------------------------------
# "0" выключает планировщик целиком: напоминания о звонках, авто-архив заявок,
# напоминания о продлении гранта, напоминания о вылете, начисления зарплаты.
# Аварийный откат — держать выключенным дольше нескольких минут небезопасно.
SCHEDULER_ENABLED="1"

# Авто-архив заявок (ТЗ 3.1): "dry" (по умолчанию) — джоба только считает
# кандидатов и раз в сутки уведомляет Основателя, ничего не архивируя.
# "on" — включает реальную архивацию. Переключать на "on" только после того,
# как Основатель посмотрел список кандидатов в режиме dry: первый прогон может
# увести в архив заметную часть старых заявок.
AUTO_ARCHIVE_MODE="dry"

# Пороги неактивности (в днях) для авто-архива. См. common/archive-rules.ts.
ENROLLED_ARCHIVE_DAYS=30
STALE_NEW_ARCHIVE_DAYS=90

# --- Скрипты первичной настройки (в рантайме не нужны) -----------------------
# prisma/create-founder.ts — создать Основателя.
FOUNDER_EMAIL=""
FOUNDER_NAME=""
FOUNDER_PASSWORD=""

# prisma/reset-admin-password.ts — сбросить пароль сотруднику.
RESET_EMAIL=""
RESET_PASSWORD=""

# prisma/seed-programs.ts — "1" заполняет справочник программ, только если он пуст.
SEED_IF_EMPTY="1"
